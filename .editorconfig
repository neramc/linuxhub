# Editor defaults for the files Biome does not own.
#
# Biome formats TS/JS/JSON/CSS and is the authority there — these settings
# agree with biome.json (tabs, 100 columns) so an editor and the formatter
# never fight. The value is in everything else: SQL migrations, Markdown, and
# YAML workflows, which Biome does not touch and which drift otherwise.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
max_line_length = 100

# YAML has no tab support at all — a tab is a parse error, not a style choice.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# D1 migrations are read as much as run; two spaces keeps column alignment
# readable at the width the schema is written to.
[*.sql]
indent_style = space
indent_size = 2

# Trailing whitespace is a hard line break in Markdown, so stripping it would
# silently reflow prose.
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
