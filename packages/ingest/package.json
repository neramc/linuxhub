{
	"name": "@linuxhub/ingest",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./content": "./src/content.ts",
		"./content-index.json": "./src/content-index.json",
		"./http": "./src/http.ts",
		"./registry": "./src/registry.ts",
		"./types": "./src/types.ts",
		"./sources/*": "./src/sources/*.ts"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@linuxhub/shared": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0",
		"yaml": "^2.9.0"
	}
}
