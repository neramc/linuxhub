---
/**
 * Side-by-side comparison of up to three distros. Every cell is pre-rendered
 * per locale into a compact JSON, and every column header (app tile + name)
 * into a <template>; the page shows a default trio without JS and
 * src/scripts/compare.ts swaps columns from the selects / ?d=a,b,c. Unknown
 * ids in ?d= are named in a status caption ([data-compare-missing]); with no
 * column chosen the table gives way to one sentence ([data-compare-empty]).
 */
import BoxedList from "~/components/adw/BoxedList.astro";
import ComboRow from "~/components/adw/ComboRow.astro";
import DistroLogo from "~/components/DistroLogo.astro";
import { localePaths, localizePath, type MessageKey, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import { featuredRelease, formatDate, getDistros, getReleases } from "~/lib/catalog";
import {
  ARCHITECTURES,
  DESKTOPS,
  DIFFICULTIES,
  FAMILIES,
  INSTALLERS,
  RELEASE_MODELS,
  SECURE_BOOT,
  USE_CASES,
} from "~/lib/taxonomy";

export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const t = useTranslations(locale);
const distros = await getDistros();
const byId = new Map(distros.map((d) => [d.id, d]));
const regions = new Intl.DisplayNames([locale], { type: "region" });
const listFormat = new Intl.ListFormat(locale, { type: "conjunction" });
const list = (items: string[]) => listFormat.format(items);
const ROWS = [
  "version",
  "eol",
  "family",
  "model",
  "desktops",
  "packages",
  "installer",
  "arch",
  "secureBoot",
  "requirements",
  "difficulty",
  "uses",
  "origin",
] as const;
type Row = (typeof ROWS)[number];
/**
 * A plain value, or [emphasized, rest]: the default desktop, then the rest of
 * the list as Intl.ListFormat words it (", KDE Plasma and Xfce").
 */
type Cell = string | [string, string];
const emphasizeFirst = (items: string[]): Cell => {
  const [first, ...rest] = listFormat.formatToParts(items);
  return [first?.value ?? "", rest.map((p) => p.value).join("")];
};

const cells: Record<string, Record<Row, Cell>> = {};
for (const d of distros) {
  const x = d.data;
  const release = featuredRelease(await getReleases(d.id));
  const base = x.basedOn ? byId.get(x.basedOn)?.data.name : x.upstream;
  const when =
    release?.channel === "rolling"
      ? RELEASE_MODELS.rolling[locale]
      : formatDate(release?.releaseDate ?? null, locale);
  cells[d.id] = {
    version: release ? [release.version, when].filter(Boolean).join(" · ") : "—",
    eol: formatDate(release?.eol ?? null, locale) ?? "—",
    family: base ? `${FAMILIES[x.family][locale]} · ${base}` : FAMILIES[x.family][locale],
    model: RELEASE_MODELS[x.releaseModel][locale],
    desktops: emphasizeFirst(x.desktops.map((k) => DESKTOPS[k][locale])),
    packages: list(x.packageManagers),
    installer: INSTALLERS[x.installer][locale],
    arch: list(x.architectures.map((a) => ARCHITECTURES[a][locale].split(" (")[0] ?? a)),
    secureBoot: SECURE_BOOT[x.secureBoot][locale],
    requirements: t("facts.requirementsValue", {
      ram: x.requirements.ramGB,
      disk: x.requirements.diskGB,
    }),
    difficulty: DIFFICULTIES[x.difficulty][locale],
    uses: list(x.useCases.map((u) => USE_CASES[u][locale])),
    origin: `${x.origin.country === "INT" ? t("facts.international") : (regions.of(x.origin.country) ?? x.origin.country)} · ${x.origin.firstRelease.slice(0, 4)}`,
  };
}
const preferred = ["ubuntu", "fedora", "linux-mint"].filter((id) => byId.has(id));
const defaults = (preferred.length >= 2 ? preferred : distros.slice(0, 3).map((d) => d.id)).slice(
  0,
  3,
);
const rowLabel = (r: Row) => t(`compare.rows.${r}` as MessageKey);
const sortedOptions = [...distros].sort((a, b) => a.data.name.localeCompare(b.data.name));
const pickerOptions = sortedOptions.map((d) => [d.id, d.data.name] as const);
---

<Base locale={locale} title={t("compare.title")} description={t("compare.lead")}>
  <div class="container page">
    <h1>{t("compare.title")}</h1>

    <div class="pickers" data-compare>
      <BoxedList>
        {
          [0, 1, 2].map((i) => (
            <ComboRow
              label={t("compare.pick", { n: i + 1 })}
              name={`d${i}`}
              options={[["", t("compare.none")], ...pickerOptions]}
              selected={defaults[i]}
              data-column={i}
            />
          ))
        }
      </BoxedList>
      <p class="note caption dim-label" role="status" data-compare-missing data-template={t("compare.missing", { ids: "{ids}" })} hidden></p>
    </div>

    <p class="caption dim-label" data-compare-empty hidden>{t("compare.empty")}</p>
    <div class="table-wrap" data-compare-table>
      <table class="compare-table">
        <thead>
          <tr>
            <td></td>
            {
              [0, 1, 2].map((i) => {
                const d = defaults[i] ? byId.get(defaults[i] as string) : undefined;
                return (
                  <th scope="col" data-head={i}>
                    {d && (
                      <a href={localizePath(`/distros/${d.id}/`, locale)} class="head-link">
                        <DistroLogo file={d.data.logo.file} name={d.data.name} size={36} eager />
                        <span>{d.data.name}</span>
                      </a>
                    )}
                  </th>
                );
              })
            }
          </tr>
        </thead>
        <tbody>
          {
            ROWS.map((row) => (
              <tr>
                <th scope="row">{rowLabel(row)}</th>
                {[0, 1, 2].map((i) => {
                  const id = defaults[i];
                  const value = id ? cells[id]?.[row] : "";
                  return (
                    <td data-cell={`${i}:${row}`} data-name={id ? byId.get(id)?.data.name : undefined}>
                      {Array.isArray(value) ? (
                        <>
                          <strong>{value[0]}</strong>
                          {value[1]}
                        </>
                      ) : (
                        value
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {
      sortedOptions.map((d) => (
        <template data-head-template={d.id}>
          <a href={localizePath(`/distros/${d.id}/`, locale)} class="head-link">
            <DistroLogo file={d.data.logo.file} name={d.data.name} size={36} />
            <span>{d.data.name}</span>
          </a>
        </template>
      ))
    }
    <script type="application/json" id="compare-data" set:html={JSON.stringify(cells).replace(/</g, "\\u003c")}></script>
  </div>
</Base>

<script>
  import "~/scripts/compare";
</script>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-6);
  }

  /* At most the text width, so no label sits a screen away from its value. */
  .pickers {
    max-inline-size: var(--text-width);
  }

  .note {
    margin-block-start: var(--space-2);
    overflow-wrap: anywhere;
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-card);
    background: var(--card-bg-color);
    box-shadow: var(--shadow-card);
  }

  .compare-table {
    inline-size: 100%;
    min-inline-size: 640px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .compare-table th,
  .compare-table td {
    padding: 12px 14px;
    text-align: start;
    vertical-align: baseline;
    inline-size: 28%;
  }

  .compare-table thead :is(th, td) {
    vertical-align: middle;
  }

  .compare-table tbody th {
    inline-size: 16%;
    font-weight: 700;
    opacity: var(--dim-opacity);
    font-size: var(--text-caption);
  }

  .compare-table tbody tr {
    border-block-start: 1px solid var(--card-shade-color);
  }

  .compare-table td :global(strong) {
    font-weight: 700;
  }

  .compare-table :global(.head-link) {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    font-size: var(--text-heading);
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .compare-table :global(.head-link:hover span) {
    text-decoration: underline;
  }
</style>
