---
/**
 * Family tree (from each distro's `basedOn`) and a timeline of first releases.
 * One narrow column: each family is a boxed list (title, member count) holding
 * its tree of FamilyNode rows; the timeline is one boxed list with a row per
 * decade, its distros an inline list of "year name" links. Zero JS.
 */
import BoxedList from "~/components/adw/BoxedList.astro";
import FamilyNode from "~/components/FamilyNode.astro";
import { localePaths, localizePath, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import { type Distro, getDistros } from "~/lib/catalog";
import { FAMILIES, type Family } from "~/lib/taxonomy";

export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const t = useTranslations(locale);
const distros = await getDistros();
const byId = new Map(distros.map((d) => [d.id, d]));
const byYear = (a: Distro, b: Distro) =>
  a.data.origin.firstRelease.localeCompare(b.data.origin.firstRelease);

const childrenOf = new Map<string, Distro[]>();
for (const d of distros) {
  if (d.data.basedOn && byId.has(d.data.basedOn)) {
    childrenOf.set(d.data.basedOn, [...(childrenOf.get(d.data.basedOn) ?? []), d]);
  }
}
for (const list of childrenOf.values()) list.sort(byYear);

const roots = distros.filter((d) => !d.data.basedOn || !byId.has(d.data.basedOn)).sort(byYear);
const familyOrder = Object.keys(FAMILIES) as Family[];
const sections = familyOrder
  .map((family) => ({ family, roots: roots.filter((r) => r.data.family === family) }))
  .filter((s) => s.roots.length > 0);
const countTree = (d: Distro): number =>
  1 + (childrenOf.get(d.id) ?? []).reduce((n, k) => n + countTree(k), 0);
const members = (list: Distro[]) => list.reduce((n, r) => n + countTree(r), 0);

const decades = new Map<number, Distro[]>();
for (const d of [...distros].sort(byYear)) {
  const decade = Math.floor(Number(d.data.origin.firstRelease.slice(0, 4)) / 10) * 10;
  decades.set(decade, [...(decades.get(decade) ?? []), d]);
}
/** "1993 Debian, 2002 Arch Linux and …": the list words, each item a link (by id). */
const listFormat = new Intl.ListFormat(locale, { type: "conjunction" });
const decadeParts = (list: Distro[]) =>
  listFormat.formatToParts(list.map((d) => d.id)).map((p) => ({
    text: p.value,
    distro: p.type === "element" ? byId.get(p.value) : undefined,
  }));
---

<Base locale={locale} title={t("family.title")} description={t("family.lead")}>
  <div class="container page narrow">
    <header class="page-header">
      <h1>{t("family.title")}</h1>
      <p class="lead">{t("family.lead")}</p>
    </header>

    <section aria-labelledby="tree-title" class="section">
      <h2 id="tree-title">{t("family.tree")}</h2>
      <div class="families">
        {
          sections.map((s) => (
            <BoxedList title={FAMILIES[s.family][locale]} id={`family-${s.family}`}>
              <p slot="suffix" class="caption dim-label">
                {members(s.roots) === 1 ? t("family.root") : t("family.roots", { count: members(s.roots) })}
                {s.roots[0]?.data.upstream && !s.roots[0].data.basedOn ? ` · ${s.roots[0].data.upstream}` : ""}
              </p>
              {s.roots.map((r) => (
                <FamilyNode distro={r} childrenOf={childrenOf} locale={locale} />
              ))}
            </BoxedList>
          ))
        }
      </div>
    </section>

    <BoxedList title={t("family.timeline")} level={2} id="timeline">
      {
        [...decades].map(([decade, list]) => (
          <li class="adw-row-item">
            <div class="adw-action-row decade">
              <h3 class="decade-title numeric">{t("family.decade", { decade })}</h3>
              <p class="decade-items numeric">
                {decadeParts(list).map(({ text, distro }) =>
                  distro ? (
                    <a href={localizePath(`/distros/${distro.id}/`, locale)}>{`${distro.data.origin.firstRelease.slice(0, 4)} ${distro.data.name}`}</a>
                  ) : (
                    text
                  ),
                )}
              </p>
            </div>
          </li>
        ))
      }
    </BoxedList>
  </div>
</Base>

<style>
  /* Families are groups of one section: 24px apart, not a section gap. */
  .families {
    display: grid;
    gap: var(--space-4);
  }

  /* A decade row: the decade, then its distros beside it, or under it when
     the row is too narrow for both. */
  .decade {
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: var(--space-1);
  }

  .decade-title {
    flex: 0 0 6.5rem;
    font-size: var(--text-heading);
    line-height: var(--line-height-heading);
  }

  .decade-items {
    flex: 1 1 20rem;
    min-inline-size: 0;
    margin: 0;
  }

  /* "2012 Linux Lite" is one item: lines break between items only. */
  .decade-items a {
    white-space: nowrap;
  }

  /* Touch screens: 44px lines, each link padded to fill its line, so every
     link is a 44px target (CLAUDE.md) without overlapping the next line. */
  @media (pointer: coarse) {
    .decade-items {
      line-height: 44px;
    }

    .decade-items a {
      padding-block: 12px;
    }
  }
</style>
