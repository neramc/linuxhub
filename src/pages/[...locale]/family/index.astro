---
/**
 * Family tree (from each distro's `basedOn`) and a timeline of first releases,
 * one row per decade with "year · name" chips. Plain nested lists —
 * accessible, responsive, zero JS.
 */
import Chip from "~/components/adw/Chip.astro";
import FamilyNode from "~/components/FamilyNode.astro";
import { localePaths, localizePath, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import { type Distro, getDistros } from "~/lib/catalog";
import { FAMILIES, type Family } from "~/lib/taxonomy";

export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const t = useTranslations(locale);
const distros = await getDistros();
const ids = new Set(distros.map((d) => d.id));
const byYear = (a: Distro, b: Distro) =>
  a.data.origin.firstRelease.localeCompare(b.data.origin.firstRelease);

const childrenOf = new Map<string, Distro[]>();
for (const d of distros) {
  if (d.data.basedOn && ids.has(d.data.basedOn)) {
    childrenOf.set(d.data.basedOn, [...(childrenOf.get(d.data.basedOn) ?? []), d]);
  }
}
for (const list of childrenOf.values()) list.sort(byYear);

const roots = distros.filter((d) => !d.data.basedOn || !ids.has(d.data.basedOn)).sort(byYear);
const familyOrder = Object.keys(FAMILIES) as Family[];
const sections = familyOrder
  .map((family) => ({ family, roots: roots.filter((r) => r.data.family === family) }))
  .filter((s) => s.roots.length > 0);
const countTree = (d: Distro): number =>
  1 + (childrenOf.get(d.id) ?? []).reduce((n, k) => n + countTree(k), 0);
const members = (list: Distro[]) => list.reduce((n, r) => n + countTree(r), 0);

const decades = new Map<number, Distro[]>();
for (const d of [...distros].sort(byYear)) {
  const decade = Math.floor(Number(d.data.origin.firstRelease.slice(0, 4)) / 10) * 10;
  decades.set(decade, [...(decades.get(decade) ?? []), d]);
}
---

<Base locale={locale} title={t("family.title")} description={t("family.lead")}>
  <div class="container page">
    <h1>{t("family.title")}</h1>

    <section aria-labelledby="tree-title" class="section">
      <h2 id="tree-title">{t("family.tree")}</h2>
      <div class="families">
        {
          sections.map((s) => (
            <section class="family adw-card padded" aria-label={FAMILIES[s.family][locale]}>
              <h3>{FAMILIES[s.family][locale]}</h3>
              <p class="caption dim-label">
                {members(s.roots) === 1 ? t("family.root") : t("family.roots", { count: members(s.roots) })}
                {s.roots[0]?.data.upstream && !s.roots[0].data.basedOn ? ` · ${s.roots[0].data.upstream}` : ""}
              </p>
              <ul class="tree" role="list">
                {s.roots.map((r) => (
                  <FamilyNode distro={r} childrenOf={childrenOf} locale={locale} />
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="timeline-title" class="section">
      <h2 id="timeline-title">{t("family.timeline")}</h2>
      <ol class="timeline" role="list">
        {
          [...decades].map(([decade, list]) => (
            <li class="decade">
              <h3 class="decade-label numeric">{t("family.decade", { decade })}</h3>
              <ul class="decade-items" role="list">
                {list.map((d) => (
                  <li>
                    <Chip href={localizePath(`/distros/${d.id}/`, locale)}>
                      {d.data.origin.firstRelease.slice(0, 4)} · {d.data.name}
                    </Chip>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-4) var(--space-6);
  }

  .section {
    display: grid;
    gap: var(--space-2);
  }

  /* Columns rather than a grid, so short families fill in beside the long one. */
  .families {
    columns: 2 340px;
    column-gap: var(--space-2);
  }

  .family {
    display: grid;
    gap: 6px;
    break-inside: avoid;
    margin-block-end: var(--space-2);
  }

  .tree,
  .tree :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tree :global(ul) {
    margin-inline-start: 14px;
    padding-inline-start: 14px;
    border-inline-start: 2px solid var(--border-color);
  }

  .tree :global(li) {
    position: relative;
  }

  .tree :global(ul > li)::before {
    content: "";
    position: absolute;
    inset-inline-start: -14px;
    inset-block-start: 21px;
    inline-size: 12px;
    border-block-start: 2px solid var(--border-color);
  }

  .tree :global(.node) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    margin-block: 2px;
    border-radius: var(--radius-button);
    color: inherit;
    text-decoration: none;
  }

  .tree :global(.node:hover) {
    background: var(--hover-color);
  }

  .tree :global(.node-name) {
    font-weight: 700;
  }

  /* One boxed-list row per decade: the decade, then its chips. */
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: var(--radius-card);
    background-color: var(--card-bg-color);
    color: var(--card-fg-color);
    box-shadow: var(--shadow-card);
  }

  .decade {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-2) 14px;
  }

  .decade + .decade {
    border-block-start: 1px solid var(--card-shade-color);
  }

  .decade-label {
    font-size: var(--text-heading);
    font-weight: 700;
  }

  .decade-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 599px) {
    .decade {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
