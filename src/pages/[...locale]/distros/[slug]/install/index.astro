---
/**
 * A distro's install guide: breadcrumb, app header (64px tile) with two
 * actions (download the image, official install docs), then the guide with
 * its table of contents in the documentation layout shared with the Linux
 * guide (DocLayout): a sidebar from 1000px, a closed disclosure above the
 * article below that.
 *
 * Distros without a written guide get a short, honest page instead (SPEC
 * §15, ADR-0016): one sentence and one action, the official install docs.
 * It is noindex, stays out of the search index (no data-pagefind-body) and
 * out of the sitemap (astro.config.mjs); the route stays so old links work.
 */
import { render } from "astro:content";
import AppHeader from "~/components/AppHeader.astro";
import Button from "~/components/adw/Button.astro";
import CopyButtons from "~/components/CopyButtons.astro";
import DocLayout from "~/components/DocLayout.astro";
import DocSources from "~/components/DocSources.astro";
import { mdxComponents } from "~/components/mdx";
import Breadcrumb from "~/components/site/Breadcrumb.astro";
import Toc from "~/components/Toc.astro";
import { LOCALES, type Locale, localeParam, localizePath, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import { getDistroDoc, getDistros } from "~/lib/catalog";
import { DIFFICULTIES, INSTALLERS, SECURE_BOOT } from "~/lib/taxonomy";
import "~/styles/prose.css";

export async function getStaticPaths() {
  const distros = await getDistros();
  return LOCALES.flatMap((locale) =>
    distros.map((d) => ({
      params: { locale: localeParam(locale), slug: d.id },
      props: { locale, slug: d.id },
    })),
  );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const t = useTranslations(locale);
const distro = (await getDistros()).find((d) => d.id === slug);
if (!distro) throw new Error(`unknown distro ${slug}`);
const d = distro.data;
const doc = await getDistroDoc(slug, locale, "install");
const rendered = doc ? await render(doc) : null;
const distroHref = localizePath(`/distros/${slug}/`, locale);
const title = t("install.title", { name: d.name });
const meta = [
  t("install.installer", { installer: INSTALLERS[d.installer][locale] }),
  t("install.secureBoot", { secureBoot: SECURE_BOOT[d.secureBoot][locale] }),
  t("install.difficulty", { difficulty: DIFFICULTIES[d.difficulty][locale] }),
];
const jsonLd = doc
  ? [
      {
        "@context": "https://schema.org",
        "@type": "TechArticle",
        headline: title,
        description: doc.data.description,
        inLanguage: locale,
        dateModified: doc.data.lastReviewed,
        about: d.name,
      },
    ]
  : [];
---

<Base
  locale={locale}
  title={title}
  description={doc?.data.description ?? t("install.description", { name: d.name })}
  mono={Boolean(rendered)}
  noindex={!rendered}
  jsonLd={jsonLd}
  image={`/og/${slug}.png`}
>
  <div
    class:list={["container page", { narrow: !rendered }]}
    data-pagefind-body={rendered ? "" : undefined}
    data-pagefind-meta={rendered ? "type:install" : undefined}
  >
    <div class="page-header">
      <Breadcrumb
        locale={locale}
        links={[
          { label: t("distro.breadcrumb"), href: localizePath("/distros/", locale) },
          { label: d.name, href: distroHref },
        ]}
        current={t("distro.installGuide")}
      />
      <AppHeader logo={d.logo.file} name={d.name} title={title} meta={meta} size={64}>
        {
          rendered && (
            <Fragment slot="actions">
              <Button href={`${distroHref}#download`} variant="suggested" icon="download">
                {t("install.downloadIso")}
              </Button>
              {d.links.installGuide && (
                <Button href={d.links.installGuide} iconEnd="external" external>
                  {t("install.officialDocs")}
                </Button>
              )}
            </Fragment>
          )
        }
      </AppHeader>
    </div>

    {
      rendered ? (
        <DocLayout title={t("install.onThisPage")}>
          <Toc slot="narrow" headings={rendered.headings} title={t("install.onThisPage")} hideTitle />
          <Toc slot="sidebar" headings={rendered.headings} title={t("install.onThisPage")} />
          <article class="prose">
            <rendered.Content components={mdxComponents} />
            <DocSources sources={doc?.data.sources ?? []} lastReviewed={doc?.data.lastReviewed ?? ""} locale={locale} />
          </article>
        </DocLayout>
      ) : (
        <div class="stub">
          <p class="heading">{t("install.comingSoonTitle")}</p>
          <p class="dim-label">{t("install.comingSoonLead")}</p>
          <div class="button-row">
            <Button href={d.links.installGuide ?? d.links.docs ?? d.links.home} variant="suggested" iconEnd="external" external>
              {t("install.officialDocs")}
            </Button>
          </div>
        </div>
      )
    }
  </div>

  {/* Only a written guide has code blocks to copy. */}
  {rendered && <CopyButtons locale={locale} />}
</Base>

<style>
  /* A guide that is not written yet: one sentence, one action. */
  .stub {
    display: grid;
    gap: var(--space-1);
  }

  .stub .button-row {
    margin-block-start: var(--space-2);
  }
</style>
