---
/**
 * A distro's page, after the GNOME Software / Flathub app page: breadcrumb,
 * app header with two actions (download, install guide), then the download
 * wizard, the facts, official links and similar distros.
 *
 * Layout (SPEC §3, PLAN C16): with an overview document the overview leads a
 * main column (overview, download, similar distros) next to a 360px aside
 * (facts, links) from 1000px; without one the page is a single narrow column
 * (download, facts, links, similar distros), so neither column leaves an
 * empty band. Both share one DOM order, which is the reading order.
 */
import { render } from "astro:content";
import AppHeader from "~/components/AppHeader.astro";
import ActionRow from "~/components/adw/ActionRow.astro";
import Banner from "~/components/adw/Banner.astro";
import BoxedList from "~/components/adw/BoxedList.astro";
import Button from "~/components/adw/Button.astro";
import DistroFacts from "~/components/DistroFacts.astro";
import DistroLinks from "~/components/DistroLinks.astro";
import DistroLogo from "~/components/DistroLogo.astro";
import DownloadWizard from "~/components/DownloadWizard.astro";
import Breadcrumb from "~/components/site/Breadcrumb.astro";
import { LOCALES, type Locale, localeParam, localizePath, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import {
  featuredRelease,
  getDistroDoc,
  getDistros,
  getMirrors,
  getReleases,
  getStatus,
} from "~/lib/catalog";
import { relatedDistros } from "~/lib/related";
import "~/styles/prose.css";

export async function getStaticPaths() {
  const distros = await getDistros();
  return LOCALES.flatMap((locale) =>
    distros.map((distro) => ({
      params: { locale: localeParam(locale), slug: distro.id },
      props: { locale, slug: distro.id },
    })),
  );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const t = useTranslations(locale);
const all = await getDistros();
const distro = all.find((d) => d.id === slug);
if (!distro) throw new Error(`unknown distro ${slug}`);
const d = distro.data;
const base = d.basedOn ? all.find((x) => x.id === d.basedOn) : undefined;
const releases = await getReleases(slug);
const release = featuredRelease(releases);
const overview = await getDistroDoc(slug, locale, "overview");
const Overview = overview ? (await render(overview)).Content : null;
const related = relatedDistros(distro, all, 3);
const status = getStatus()[slug];
const stale = Boolean(status?.releases?.failingSince);
const catalogHref = localizePath("/distros/", locale);
// The guide on this site when it is written; otherwise the project's own docs.
const guide = (await getDistroDoc(slug, locale, "install"))
  ? localizePath(`/distros/${slug}/install/`, locale)
  : undefined;
const officialGuide = d.links.installGuide ?? d.links.docs ?? d.links.home;
const description = `${d.name}: ${d.tagline[locale]}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: d.name,
    description: d.tagline[locale],
    applicationCategory: "OperatingSystem",
    operatingSystem: "Linux",
    ...(release ? { softwareVersion: release.version } : {}),
    url: d.links.home,
    downloadUrl: d.links.download,
    offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: t("nav.distros"),
        item: new URL(catalogHref, Astro.site).href,
      },
      { "@type": "ListItem", position: 2, name: d.name },
    ],
  },
];
---

<Base locale={locale} title={d.name} description={description} jsonLd={jsonLd} image={`/og/${slug}.png`}>
  {stale && <Banner tone="warning" title={t("distro.dataStale")} />}
  <div class:list={["container page", { narrow: !Overview }]} data-pagefind-body data-pagefind-meta="type:distro">
    <p class="visually-hidden" aria-hidden="true" data-pagefind-weight="6">{[slug, ...d.aliases].join(" ")}</p>

    <div class="page-header">
      <Breadcrumb locale={locale} links={[{ label: t("distro.breadcrumb"), href: catalogHref }]} current={d.name} />
      <AppHeader logo={d.logo.file} name={d.name} tagline={d.tagline[locale]}>
        <Fragment slot="actions">
          <Button href="#download" icon="download">{t("distro.download")}</Button>
          {
            guide ? (
              <Button href={guide}>{t("distro.installGuide")}</Button>
            ) : (
              <Button href={officialGuide} iconEnd="external" external>
                {t("install.officialDocs")}
              </Button>
            )
          }
        </Fragment>
      </AppHeader>
    </div>

    <div class:list={["detail", { layout: Boolean(Overview) }]}>
      <div class="main">
        {
          Overview && (
            <section class="section" aria-labelledby="overview-title">
              <h2 id="overview-title">{t("distro.overview")}</h2>
              <div class="prose">
                <Overview />
              </div>
            </section>
          )
        }

        <div data-pagefind-ignore>
          <DownloadWizard
            slug={slug}
            locale={locale}
            strategy={d.download.strategy}
            officialDownload={d.links.download}
            releases={releases}
            mirrorCountries={getMirrors(slug)?.mirrors.flatMap((m) => m.country ?? []) ?? null}
            guide={guide}
            officialGuide={officialGuide}
          />
        </div>
      </div>

      <aside class="side">
        <DistroFacts distro={distro} base={base} releases={releases} locale={locale} />
        <div data-pagefind-ignore><DistroLinks distro={distro} locale={locale} /></div>
      </aside>

      {
        related.length > 0 && (
          <div class="related" data-pagefind-ignore>
            <BoxedList id="related" title={t("distro.related")} level={2}>
              {related.map((r) => (
                <ActionRow href={localizePath(`/distros/${r.id}/`, locale)} title={r.data.name} subtitle={r.data.tagline[locale]}>
                  <DistroLogo slot="prefix" file={r.data.logo.file} name={r.data.name} size={36} />
                </ActionRow>
              ))}
            </BoxedList>
          </div>
        )
      }
    </div>
  </div>
</Base>

<style>
  /* One column: the download, the facts and links, then similar distros. */
  .detail,
  .main,
  .side {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-section);
    align-content: start;
  }

  /* With an overview, from 1000px: overview, download and similar distros in
     the main column, facts and links in the aside next to them. The aside
     spans both rows, so neither column waits for the other. */
  @media (width >= 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) var(--aside-width);
      column-gap: var(--space-5);
      align-items: start;
    }

    .layout > .side {
      grid-column: 2;
      grid-row: 1;
    }

    .layout:has(> .related) > .side {
      grid-row: 1 / span 2;
    }

    .layout > .related {
      grid-column: 1;
    }
  }
</style>
