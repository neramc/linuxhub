---
import { localePaths, useTranslations } from "~/i18n";
// Temporary home until Phase 4 (docs/plan.md §10).
import Base from "~/layouts/Base.astro";

export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Base locale={locale}>
  <section class="container">
    <h1 class="title-display">{t("site.tagline")}</h1>
  </section>
</Base>
