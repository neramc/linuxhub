---
/**
 * Home (ADR-0014): the "popular today" carousel first, then use-case chips,
 * recommended distros (not repeating the carousel), new releases (one row per
 * distro, flavors grouped) and a link into the Linux guide.
 */
import ActionRow from "~/components/adw/ActionRow.astro";
import Button from "~/components/adw/Button.astro";
import Icon from "~/components/adw/Icon.astro";
import DistroCard from "~/components/DistroCard.astro";
import DistroLogo from "~/components/DistroLogo.astro";
import PopularCarousel from "~/components/PopularCarousel.astro";
import UseCaseChips from "~/components/UseCaseChips.astro";
import { localePaths, localizePath, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import {
  formatDate,
  getDistros,
  getHistory,
  getTodaysDistros,
  groupReleases,
  latestReleaseGroups,
} from "~/lib/catalog";

export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const t = useTranslations(locale);
const distros = await getDistros();
const today = await getTodaysDistros(5);
const inCarousel = new Set(today.items.map((d) => d.id));
const featured = distros
  .filter((d) => d.data.status === "active" && !inCarousel.has(d.id))
  .slice(0, 6);
const recent = latestReleaseGroups(groupReleases(getHistory(), distros), 5);
const list = new Intl.ListFormat(locale, { style: "short", type: "unit" });
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Linuxhub",
    url: new URL(localizePath("/", locale), Astro.site).href,
    inLanguage: locale,
  },
];
---

<Base locale={locale} jsonLd={jsonLd}>
  <div class="container home">
    <h1 class="visually-hidden">{t("home.title")}</h1>

    <PopularCarousel locale={locale} today={today} />

    <UseCaseChips locale={locale} />

    <section aria-labelledby="featured-title" class="section">
      <div class="section-header">
        <h2 id="featured-title">{t("home.featured")}</h2>
        <Button href={localizePath("/distros/", locale)} variant="flat" iconEnd="go-next">{t("home.browse")}</Button>
      </div>
      <ul class="grid" role="list">
        {featured.map((d) => <li><DistroCard distro={d} locale={locale} /></li>)}
      </ul>
    </section>

    {
      recent.length > 0 && (
        <section aria-labelledby="recent-title" class="section">
          <div class="section-header">
            <h2 id="recent-title">{t("home.recent")}</h2>
            <Button href={localizePath("/releases/", locale)} variant="flat" iconEnd="go-next">
              {t("home.allReleases")}
            </Button>
          </div>
          <ul class="adw-boxed-list" role="list">
            {recent.map((g) => (
              <li>
                <a class="adw-action-row activatable" href={localizePath(`/distros/${g.distro.id}/`, locale)}>
                  <DistroLogo file={g.distro.data.logo.file} name={g.distro.data.name} size={36} />
                  <span class="adw-row-text">
                    <span class="adw-row-title">
                      {g.distro.data.name} {list.format(g.versions)}
                    </span>
                    <span class="adw-row-subtitle">
                      {g.flavors.map((f) => `${f.data.name} · `).join("")}
                      <time datetime={g.date}>{formatDate(g.date, locale)}</time>
                    </span>
                  </span>
                  <Icon name="go-next" class="adw-row-chevron" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <ul class="adw-boxed-list" role="list">
      <ActionRow href={localizePath("/learn/", locale)} title={t("home.newToLinux")} icon="contents">
        <span class="dim-label">{t("nav.learn")}</span>
      </ActionRow>
    </ul>
  </div>
</Base>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-3) var(--space-6);
  }

  .section {
    display: grid;
    gap: var(--space-2);
  }

  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-2);
  }

  .section-header > :global(.adw-button) {
    margin-inline-end: -8px; /* align the flat button's label with the content edge */
  }

  .grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
</style>
