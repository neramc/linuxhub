---
/**
 * Component showcase for design review (docs/plan.md §4). Built only in dev or
 * when LINUXHUB_SHOWCASE=1 — never part of the production site. One h1 (the
 * AppHeader); StatusPage is the 404 page's alone, so it is shown there.
 */
import { getCollection } from "astro:content";
import AppHeader from "~/components/AppHeader.astro";
import ActionRow from "~/components/adw/ActionRow.astro";
import Badge from "~/components/adw/Badge.astro";
import Banner from "~/components/adw/Banner.astro";
import BoxedList from "~/components/adw/BoxedList.astro";
import Button from "~/components/adw/Button.astro";
import Callout from "~/components/adw/Callout.astro";
import Chip from "~/components/adw/Chip.astro";
import ChoiceGroup from "~/components/adw/ChoiceGroup.astro";
import ComboRow from "~/components/adw/ComboRow.astro";
import ExpanderRow from "~/components/adw/ExpanderRow.astro";
import Kbd from "~/components/adw/Kbd.astro";
import SearchEntry from "~/components/adw/SearchEntry.astro";
import ViewSwitcher from "~/components/adw/ViewSwitcher.astro";
import CompareTable from "~/components/CompareTable.astro";
import CopyButtons from "~/components/CopyButtons.astro";
import DistroCard from "~/components/DistroCard.astro";
import DistroLogo from "~/components/DistroLogo.astro";
import Breadcrumb from "~/components/site/Breadcrumb.astro";
import { LOCALES, localeParam, localizePath, type MessageKey, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import { formatDate } from "~/lib/catalog";
import { DESKTOPS, DIFFICULTIES, FAMILIES, INSTALLERS, SECURE_BOOT } from "~/lib/taxonomy";
import "~/styles/prose.css";

export function getStaticPaths() {
  if (!import.meta.env.DEV && !process.env.LINUXHUB_SHOWCASE) return [];
  return LOCALES.map((locale) => ({ params: { locale: localeParam(locale) }, props: { locale } }));
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const distros = (await getCollection("distros"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
const sample = distros[0]?.data;
const swatches = [
  ["accent-bg-color", "accent-color", "destructive-color", "success-color", "warning-color"],
  ["window-bg-color", "view-bg-color", "card-bg-color", "headerbar-bg-color", "sidebar-bg-color"],
];

// Three columns of the compare table, with sample rows.
const listFormat = new Intl.ListFormat(locale, { type: "conjunction" });
const trio = distros.slice(0, 3);
const compareRows = (["family", "desktops", "packages"] as const).map((key) => ({
  key,
  label: t(`compare.rows.${key}` as MessageKey),
}));
const compareColumns = trio.map((d) => ({
  id: d.id,
  name: d.data.name,
  logo: d.data.logo.file,
  href: localizePath(`/distros/${d.id}/`, locale),
}));
const compareCells = Object.fromEntries(
  trio.map((d) => {
    const [first, ...rest] = listFormat.formatToParts(
      d.data.desktops.map((k) => DESKTOPS[k][locale]),
    );
    return [
      d.id,
      {
        family: FAMILIES[d.data.family][locale],
        desktops: [first?.value ?? "", rest.map((p) => p.value).join("")] as [string, string],
        packages: listFormat.format(d.data.packageManagers),
      },
    ];
  }),
);
---

<Base locale={locale} title="Design system" noindex mono>
  <Banner title="Linuxhub design review — libadwaita 1.10 tokens">
    <Button variant="suggested" pill={false}>Action</Button>
  </Banner>
  <Banner tone="warning" title="최근 공식 소스에 접속하지 못해 표시된 정보가 오래되었을 수 있습니다." />
  <div class="container showcase">
    {
      sample && (
        <div class="page-header">
          <Breadcrumb
            locale={locale}
            links={[{ label: t("distro.breadcrumb"), href: localizePath("/distros/", locale) }]}
            current={sample.name}
          />
          <AppHeader
            logo={sample.logo.file}
            name={sample.name}
            tagline={sample.tagline[locale]}
            meta={[
              t("install.installer", { installer: INSTALLERS[sample.installer][locale] }),
              t("install.secureBoot", { secureBoot: SECURE_BOOT[sample.secureBoot][locale] }),
              t("install.difficulty", { difficulty: DIFFICULTIES[sample.difficulty][locale] }),
            ]}
          >
            <Button slot="actions" href="#" icon="download">{t("distro.download")}</Button>
            <Button slot="actions" href="#">{t("distro.installGuide")}</Button>
          </AppHeader>
        </div>
      )
    }

    <section>
      <p class="dim-label">AppHeader h1 = Title 1 · Adwaita Sans · 한글은 시스템 고딕 · 12px card radius · 9px buttons</p>
      <h2>Title 2 — 설치 가이드</h2>
      <h3>Title 3 — 부팅 USB 만들기</h3>
      <h4>Heading — 체크섬 확인</h4>
      <p>
        본문 텍스트입니다. Linux Mint는 Ubuntu LTS를 기반으로 하는 입문자 친화적 배포판입니다.
        <a href="#">링크 스타일</a>과 <code>sudo apt update</code> 인라인 코드, <Kbd>Ctrl</Kbd> + <Kbd>K</Kbd>.
      </p>
    </section>

    <section class="row">
      <Button variant="suggested" pill icon="download">ISO 다운로드</Button>
      <Button pill>설치 가이드</Button>
      <Button variant="suggested">Suggested</Button>
      <Button>Default</Button>
      <Button variant="flat">Flat</Button>
      <Button variant="destructive">Destructive</Button>
      <Button icon="copy" label="복사" />
      <Button icon="menu" label="메뉴" variant="flat" circular />
      <Button href="#" iconEnd="external">공식 사이트</Button>
    </section>

    <section class="row">
      <ViewSwitcher
        label="Views"
        items={[
          { href: "#", label: "개요", icon: "about", current: true },
          { href: "#", label: "설치 가이드", icon: "contents" },
          { href: "#", label: "다운로드", icon: "download" },
        ]}
      />
      <Badge>Debian 계열</Badge>
      <Badge tone="success">지원 중</Badge>
      <Badge tone="warning">곧 지원 종료</Badge>
      <Badge tone="error">지원 종료</Badge>
    </section>

    <section class="row">
      <Chip href="#" icon="gaming" current>게이밍</Chip>
      <Chip href="#" icon="terminal">개발</Chip>
      <Chip href="#">Debian 계열</Chip>
    </section>

    {/* Form choices (SPEC §8): a toggle group from 600px for short single
        choices, radio rows for the others, check rows for several. */}
    <section class="two">
      <ChoiceGroup
        legend="리눅스를 얼마나 써 보셨나요?"
        name="experience"
        toggle
        choices={[
          { value: "new", label: "처음이에요", checked: true },
          { value: "some", label: "조금 써 봤어요" },
          { value: "expert", label: "익숙해요" },
        ]}
      />
      <ChoiceGroup
        legend="어떤 컴퓨터인가요?"
        name="hardware"
        choices={[
          { value: "modern", label: "최신·고사양" },
          { value: "average", label: "보통", checked: true },
          { value: "old", label: "오래됐거나 메모리가 적어요(4GB 이하)" },
        ]}
      />
      <ChoiceGroup
        legend="주로 무엇에 쓰시나요? (여러 개 선택 가능)"
        name="uses"
        type="checkbox"
        choices={[
          { value: "desktop", label: "웹·문서·영상", checked: true },
          { value: "gaming", label: "게임" },
        ]}
      />
    </section>

    <section class="row">
      <SearchEntry locale={locale} name="q" label="배포판 검색" />
    </section>

    <nav class="nav-rows" aria-label="Navigation rows">
      <ul role="list">
        <li><a class="adw-nav-row" href="#" aria-current="page">리눅스란 무엇인가</a></li>
        <li><a class="adw-nav-row" href="#">배포판이란</a></li>
        <li><a class="adw-nav-row" href="#">데스크톱 환경</a></li>
      </ul>
    </nav>

    <div class="card-grid">
      {distros.map((d, i) => <DistroCard distro={d} locale={locale} eager={i < 3} />)}
    </div>

    <section class="two">
      <BoxedList title="정보">
        <ActionRow title="Fedora 43" subtitle="최신 버전" property />
        <ActionRow title="GNOME" subtitle="기본 데스크톱" property />
        <ActionRow title={new Intl.ListFormat(locale, { type: "conjunction" }).format(["dnf", "rpm", "flatpak"])} subtitle="패키지 관리" property />
        <ActionRow title="공식 웹사이트" icon="website" href="https://fedoraproject.org/" external />
        <ActionRow title="설치 가이드" icon="contents" href="#" />
      </BoxedList>
      <BoxedList title="다운로드">
        <ExpanderRow title="Workstation · x86_64" subtitle="2.3 GB · ISO">
          <p class="checksum">SHA256 3f1c…9ab2</p>
        </ExpanderRow>
        <ComboRow label="버전" name="version" options={[["26.04.1", "26.04.1 “Resolute Raccoon” (최신, LTS)"], ["25.10", "25.10 “Questing Quokka”"]]} selected="26.04.1" />
        <ComboRow label="미러" name="mirror" options={[["https://ftp.kaist.ac.kr/", "ftp.kaist.ac.kr · 약 8km"]]}>
          <span slot="subtitle">대한민국에서 가장 가까움</span>
        </ComboRow>
        <ActionRow title="미러" subtitle="KAIST (대한민국) · 추천">
          <Button variant="suggested" icon="download" label="다운로드" />
        </ActionRow>
      </BoxedList>
    </section>

    {/* A section-level list (h2, title-2) with a suffix button, as on the home page. */}
    <BoxedList title={t("home.recent")} level={2}>
      <Button slot="suffix" href="#" variant="flat" iconEnd="go-next">{t("home.allReleases")}</Button>
      {distros.slice(0, 2).map((d) => (
        <ActionRow href="#" title={`${d.data.name} 1.0`}>
          <DistroLogo slot="prefix" file={d.data.logo.file} name={d.data.name} size={36} />
          <Fragment slot="subtitle"><time datetime="2026-04-23">{formatDate("2026-04-23", locale)}</time></Fragment>
        </ActionRow>
      ))}
    </BoxedList>

    <section>
      <Callout type="note" title="참고">체크섬은 항상 공식 원본 서버의 값을 보여줍니다.</Callout>
      <Callout type="tip" title="팁">Ventoy를 쓰면 USB 하나에 여러 ISO를 넣을 수 있습니다.</Callout>
      <Callout type="warning" title="주의">설치 중 디스크를 지우면 데이터가 모두 사라집니다.</Callout>
    </section>

    {/* States inside the component (SPEC §14–16): loading, empty with its one
        way out, and an error with what to do. */}
    <BoxedList title="상태">
      <ActionRow>
        <span slot="prefix" class="adw-spinner" aria-hidden="true"></span>
        <span slot="title">{t("download.loadingFiles")}</span>
      </ActionRow>
      <ActionRow>
        <span slot="title">{t("catalog.emptyTitle")}</span>
        <Button>{t("catalog.reset")}</Button>
      </ActionRow>
      <ActionRow tone="error" icon="warning">
        <span slot="title">{t("download.mirrorsError")}</span>
        <Button>{t("common.retry")}</Button>
      </ActionRow>
    </BoxedList>

    {/* The compare page's table: a real table from 768px, one group per
        attribute below (open this page at 390px for that layout). */}
    <CompareTable rows={compareRows} columns={compareColumns} cells={compareCells} />

    {/* Code block with its copy button; a copy is confirmed by the toast. */}
    <section class="prose">
      <p>체크섬 파일과 이미지를 같은 폴더에 두고 확인합니다.</p>
      <pre class="language-bash"><code class="language-bash">sha256sum -c SHA256SUMS --ignore-missing
sudo dnf upgrade --refresh</code></pre>
    </section>
    <CopyButtons locale={locale} />

    <section class="two">
      {
        swatches.map((group) => (
          <BoxedList>
            {group.map((s) => (
              <ActionRow>
                <span slot="prefix" class={`swatch swatch-${s}`}></span>
                <code slot="title">--{s}</code>
              </ActionRow>
            ))}
          </BoxedList>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
  }

  .showcase section {
    display: grid;
    gap: var(--space-2);
  }

  .showcase .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .two {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    align-items: start;
  }

  .nav-rows {
    max-inline-size: var(--sidebar-width);
  }

  .swatch {
    flex: none;
    inline-size: 36px;
    block-size: 36px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-button);
  }

  .swatch-accent-bg-color { background: var(--accent-bg-color); }
  .swatch-accent-color { background: var(--accent-color); }
  .swatch-destructive-color { background: var(--destructive-color); }
  .swatch-success-color { background: var(--success-color); }
  .swatch-warning-color { background: var(--warning-color); }
  .swatch-window-bg-color { background: var(--window-bg-color); }
  .swatch-view-bg-color { background: var(--view-bg-color); }
  .swatch-card-bg-color { background: var(--card-bg-color); }
  .swatch-headerbar-bg-color { background: var(--headerbar-bg-color); }
  .swatch-sidebar-bg-color { background: var(--sidebar-bg-color); }
</style>
