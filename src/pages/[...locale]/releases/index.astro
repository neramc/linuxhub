---
/**
 * Release news by month: one boxed list per month under a section h2 with
 * the month (PLAN C3). Rows are grouped like the home page (one row per
 * distro and series; same-day flavors join their parent's row as its
 * subtitle) and end with the day only, since the month is the heading
 * (PLAN C2). The RSS feed keeps one item per version
 * (src/pages/[...locale]/rss.xml.ts).
 */
import ActionRow from "~/components/adw/ActionRow.astro";
import BoxedList from "~/components/adw/BoxedList.astro";
import Button from "~/components/adw/Button.astro";
import DistroLogo from "~/components/DistroLogo.astro";
import { localePaths, localizePath, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import { getDistros, getHistory, groupReleases, type ReleaseGroup } from "~/lib/catalog";
import { formatDay, formatMonth } from "~/lib/format";

export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const t = useTranslations(locale);
const groups = groupReleases(getHistory(), await getDistros());
const byMonth = new Map<string, ReleaseGroup[]>();
for (const g of groups) {
  const key = g.date.slice(0, 7);
  byMonth.set(key, [...(byMonth.get(key) ?? []), g]);
}
const list = new Intl.ListFormat(locale, { style: "short", type: "unit" });
const flavorList = new Intl.ListFormat(locale, { type: "conjunction" });
---

<Base locale={locale} title={t("releases.title")} description={t("releases.lead")}>
  <div class="container page narrow">
    <header class="page-header">
      <h1>{t("releases.title")}</h1>
      <p class="lead">{t("releases.lead")}</p>
      <div class="button-row">
        <Button href={localizePath("/rss.xml", locale)} icon="bookmark">{t("releases.feed")}</Button>
      </div>
    </header>

    {
      groups.length === 0 ? (
        <p>{t("releases.empty")}</p>
      ) : (
        [...byMonth].map(([month, rows]) => (
          <BoxedList id={`month-${month}`} level={2}>
            <time slot="title" datetime={month}>{formatMonth(month, locale)}</time>
            {rows.map((g) => (
              <ActionRow
                href={localizePath(`/distros/${g.distro.id}/`, locale)}
                title={`${g.distro.data.name} ${list.format(g.versions)}`}
                subtitle={
                  g.flavors.length > 0 ? flavorList.format(g.flavors.map((f) => f.data.name)) : undefined
                }
              >
                <DistroLogo slot="prefix" file={g.distro.data.logo.file} name={g.distro.data.name} size={36} />
                <time class="dim-label" datetime={g.date}>{formatDay(g.date, locale)}</time>
              </ActionRow>
            ))}
          </BoxedList>
        ))
      )
    }
  </div>
</Base>
