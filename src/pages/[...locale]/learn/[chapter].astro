---
/**
 * Linux guide chapter: two columns (AdwNavigationSplitView-like). The sidebar
 * lists the chapters with the current chapter's sections nested under it; on
 * narrow screens it folds into a "Contents" expander above the article. The
 * chapter ends with its sources, three related distros and prev/next.
 */
import { render } from "astro:content";
import ExpanderRow from "~/components/adw/ExpanderRow.astro";
import Icon from "~/components/adw/Icon.astro";
import ChapterNav from "~/components/ChapterNav.astro";
import DistroCard from "~/components/DistroCard.astro";
import DocSources from "~/components/DocSources.astro";
import { mdxComponents } from "~/components/mdx";
import { LOCALES, type Locale, localeParam, localizePath, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import { getDistros } from "~/lib/catalog";
import { getChapters, readingMinutes } from "~/lib/learn";
import "~/styles/prose.css";

export async function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    for (const c of await getChapters(locale)) {
      paths.push({
        params: { locale: localeParam(locale), chapter: c.slug },
        props: { locale, slug: c.slug },
      });
    }
  }
  return paths;
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const t = useTranslations(locale);
const chapters = await getChapters(locale);
const index = chapters.findIndex((c) => c.slug === slug);
const chapter = chapters[index];
if (!chapter) throw new Error(`unknown chapter ${slug}`);
const { Content, headings } = await render(chapter);
const prev = chapters[index - 1];
const next = chapters[index + 1];
const distros = await getDistros();
const related = chapter.data.related
  .map((s) => distros.find((d) => d.id === s))
  .filter((d): d is NonNullable<typeof d> => Boolean(d))
  .slice(0, 3);
const href = (s: string) => localizePath(`/learn/${s}/`, locale);
const minutes = readingMinutes(chapter.body, locale);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: chapter.data.title,
    description: chapter.data.description,
    inLanguage: locale,
    dateModified: chapter.data.lastReviewed,
    isPartOf: { "@type": "CreativeWorkSeries", name: t("learn.title") },
  },
];
---

<Base locale={locale} title={chapter.data.title} description={chapter.data.description} mono jsonLd={jsonLd} image="/og/learn.png">
  <div class="container page">
    <div class="sidebar">
      <ul class="adw-boxed-list chapter-menu" role="list">
        <ExpanderRow title={t("learn.chapters")} subtitle={`${chapter.data.order}. ${chapter.data.navTitle}`}>
          <ChapterNav chapters={chapters} current={slug} locale={locale} headings={headings} label={t("learn.chapters")} />
        </ExpanderRow>
      </ul>
      <div class="chapter-nav-wide">
        <ChapterNav chapters={chapters} current={slug} locale={locale} headings={headings} label={t("learn.chapters")} />
      </div>
    </div>

    <div class="content">
      <article class="prose" data-pagefind-body data-pagefind-meta="type:guide">
        <p class="kicker caption dim-label" data-pagefind-ignore>
          {t(`learn.groups.${chapter.data.group}`)} · {t("learn.readingTime", { minutes })}
        </p>
        <h1>{chapter.data.title}</h1>
        <p class="lead">{chapter.data.description}</p>
        <Content components={mdxComponents} />
        <DocSources sources={chapter.data.sources} lastReviewed={chapter.data.lastReviewed} locale={locale} />
      </article>

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-title" data-pagefind-ignore>
            <h2 id="related-title">{t("learn.related")}</h2>
            <ul class="related-grid" role="list">
              {related.map((d) => <li><DistroCard distro={d} locale={locale} /></li>)}
            </ul>
          </section>
        )
      }

      <nav class="pager" aria-label={t("learn.pager")} data-pagefind-ignore>
        {
          prev ? (
            <a class="pager-link adw-card activatable" href={href(prev.slug)} rel="prev">
              <span class="caption dim-label pager-label"><Icon name="go-previous" /> {t("learn.previous")}</span>
              <span class="heading">{prev.data.navTitle}</span>
            </a>
          ) : <span />
        }
        {
          next && (
            <a class="pager-link next adw-card activatable" href={href(next.slug)} rel="next">
              <span class="caption dim-label pager-label">{t("learn.next")} <Icon name="go-next" /></span>
              <span class="heading">{next.data.navTitle}</span>
            </a>
          )
        }
      </nav>
    </div>
  </div>
</Base>

<script>
  import "~/scripts/copy-code";

  // On phones wide tables scroll sideways inside their own box (prose.css).
  // A scrolling box must be reachable by keyboard (WCAG 2.1.1), so it gets a
  // tab stop while (and only while) it actually overflows.
  const tables = [...document.querySelectorAll<HTMLTableElement>(".prose table")];
  const sync = () => {
    for (const table of tables) {
      if (table.scrollWidth > table.clientWidth + 1) table.tabIndex = 0;
      else table.removeAttribute("tabindex");
    }
  };
  if (tables.length) {
    sync();
    let frame = 0;
    addEventListener("resize", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(sync);
    });
  }
</script>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-6);
  }

  .sidebar,
  .content {
    min-inline-size: 0;
  }

  .chapter-nav-wide {
    display: none;
  }

  .chapter-menu :global(.adw-expander-content) {
    padding: var(--space-2) 8px;
  }

  /* Sources, related distros and prev/next line up with the article. */
  .content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    max-inline-size: var(--text-width);
  }

  .kicker {
    margin-block-end: -0.5em;
  }

  .lead {
    font-size: 1.1875rem;
    opacity: var(--dim-opacity);
  }

  .related {
    display: grid;
    gap: var(--space-2);
  }

  .related h2 {
    font-size: var(--text-title-3);
  }

  .related-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: minmax(0, 1fr);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .pager-link {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: var(--space-2) var(--space-3);
  }

  .pager-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .pager-link.next {
    grid-column: 2;
    justify-items: end;
    text-align: end;
  }

  @media (min-width: 960px) {
    .page {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: var(--space-5);
      align-items: start;
    }

    .sidebar {
      position: sticky;
      inset-block-start: calc(var(--headerbar-height) + var(--space-3));
      max-block-size: calc(100dvh - var(--headerbar-height) - var(--space-5));
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      padding: 2px;
      margin: -2px;
    }

    .chapter-menu {
      display: none;
    }

    .chapter-nav-wide {
      display: block;
    }
  }
</style>
