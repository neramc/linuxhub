---
/**
 * Linux guide chapter: the title, the lead and one caption (group · reading
 * time), then the documentation layout shared with the install guides
 * (DocLayout): the chapters with the current chapter's sections
 * nested under it, as a sidebar from 1000px and a closed "Chapters" expander
 * above the article below that. The chapter ends with its sources, up to
 * three related distros and the previous / next chapter as boxed-list rows.
 */
import { render } from "astro:content";
import ActionRow from "~/components/adw/ActionRow.astro";
import BoxedList from "~/components/adw/BoxedList.astro";
import ChapterNav from "~/components/ChapterNav.astro";
import CopyButtons from "~/components/CopyButtons.astro";
import DistroLogo from "~/components/DistroLogo.astro";
import DocLayout from "~/components/DocLayout.astro";
import DocSources from "~/components/DocSources.astro";
import { mdxComponents } from "~/components/mdx";
import { LOCALES, type Locale, localeParam, localizePath, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import { getDistros } from "~/lib/catalog";
import { getChapters, readingMinutes } from "~/lib/learn";
import "~/styles/prose.css";

export async function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    for (const c of await getChapters(locale)) {
      paths.push({
        params: { locale: localeParam(locale), chapter: c.slug },
        props: { locale, slug: c.slug },
      });
    }
  }
  return paths;
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const t = useTranslations(locale);
const chapters = await getChapters(locale);
const index = chapters.findIndex((c) => c.slug === slug);
const chapter = chapters[index];
if (!chapter) throw new Error(`unknown chapter ${slug}`);
const { Content, headings } = await render(chapter);
const prev = chapters[index - 1];
const next = chapters[index + 1];
const distros = await getDistros();
const related = chapter.data.related
  .map((s) => distros.find((d) => d.id === s))
  .filter((d): d is NonNullable<typeof d> => Boolean(d))
  .slice(0, 3);
const href = (s: string) => localizePath(`/learn/${s}/`, locale);
const minutes = readingMinutes(chapter.body, locale);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: chapter.data.title,
    description: chapter.data.description,
    inLanguage: locale,
    dateModified: chapter.data.lastReviewed,
    isPartOf: { "@type": "CreativeWorkSeries", name: t("learn.title") },
  },
];
---

<Base locale={locale} title={chapter.data.title} description={chapter.data.description} mono jsonLd={jsonLd} image="/og/learn.png">
  <div class="container page" data-pagefind-body data-pagefind-meta="type:guide">
    <header class="page-header">
      <h1>{chapter.data.title}</h1>
      <p class="lead">{chapter.data.description}</p>
      <p class="caption dim-label" data-pagefind-ignore>
        {t(`learn.groups.${chapter.data.group}`)} · {t("learn.readingTime", { minutes })}
      </p>
    </header>

    <DocLayout title={t("learn.chapters")} subtitle={`${chapter.data.order}. ${chapter.data.navTitle}`}>
      <ChapterNav slot="narrow" chapters={chapters} current={slug} locale={locale} headings={headings} label={t("learn.chapters")} />
      <ChapterNav slot="sidebar" chapters={chapters} current={slug} locale={locale} headings={headings} label={t("learn.chapters")} />

      <div class="doc-main">
        <article class="prose">
          <Content components={mdxComponents} />
          <DocSources sources={chapter.data.sources} lastReviewed={chapter.data.lastReviewed} locale={locale} />
        </article>

        {
          related.length > 0 && (
            <div data-pagefind-ignore>
              <BoxedList id="related" title={t("learn.related")} level={2}>
                {related.map((d) => (
                  <ActionRow href={localizePath(`/distros/${d.id}/`, locale)} title={d.data.name} subtitle={d.data.tagline[locale]}>
                    <DistroLogo slot="prefix" file={d.data.logo.file} name={d.data.name} size={36} />
                  </ActionRow>
                ))}
              </BoxedList>
            </div>
          )
        }

        {
          (prev || next) && (
            <nav aria-label={t("learn.pager")} data-pagefind-ignore>
              <BoxedList>
                {prev && <ActionRow href={href(prev.slug)} rel="prev" title={prev.data.navTitle} subtitle={t("learn.previous")} />}
                {next && <ActionRow href={href(next.slug)} rel="next" title={next.data.navTitle} subtitle={t("learn.next")} />}
              </BoxedList>
            </nav>
          )
        }
      </div>
    </DocLayout>
  </div>
  <CopyButtons locale={locale} />
</Base>

<script>
  // On phones wide tables scroll sideways inside their own box (prose.css).
  // A scrolling box must be reachable by keyboard (WCAG 2.1.1), so it gets a
  // tab stop while (and only while) it actually overflows.
  const tables = [...document.querySelectorAll<HTMLTableElement>(".prose table")];
  const sync = () => {
    for (const table of tables) {
      if (table.scrollWidth > table.clientWidth + 1) table.tabIndex = 0;
      else table.removeAttribute("tabindex");
    }
  };
  if (tables.length) {
    sync();
    let frame = 0;
    addEventListener("resize", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(sync);
    });
  }
</script>

<style>
  /* The article, the related distros and prev/next share one width, so the
     lists line up with the article's tables and sources. */
  .doc-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-section);
    max-inline-size: var(--text-width);
  }
</style>
