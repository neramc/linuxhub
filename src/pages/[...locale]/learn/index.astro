---
/**
 * Linux guide index: one boxed list per group (AdwPreferencesPage-like clamp).
 * Row = "N. title", a one-line description and the reading time.
 */
import ActionRow from "~/components/adw/ActionRow.astro";
import BoxedList from "~/components/adw/BoxedList.astro";
import Button from "~/components/adw/Button.astro";
import { localePaths, localizePath, useTranslations } from "~/i18n";
import Base from "~/layouts/Base.astro";
import { GROUPS, getChapters, readingMinutes } from "~/lib/learn";

export const getStaticPaths = localePaths;
const { locale } = Astro.props;
const t = useTranslations(locale);
const chapters = await getChapters(locale);
const first = chapters[0];
---

<Base locale={locale} title={t("learn.title")} description={t("learn.lead")} image="/og/learn.png">
  <div class="container page">
    <header class="page-header">
      <h1>{t("learn.title")}</h1>
      {first && <Button href={localizePath(`/learn/${first.slug}/`, locale)} variant="suggested" pill icon="contents">{t("learn.start")}</Button>}
    </header>

    {
      GROUPS.map((group) => {
        const items = chapters.filter((c) => c.data.group === group);
        return items.length ? (
          <BoxedList title={t(`learn.groups.${group}`)} level={2} id={`group-${group}`} class="learn-chapters">
            {items.map((c) => (
              <ActionRow
                title={`${c.data.order}. ${c.data.navTitle}`}
                subtitle={c.data.description}
                href={localizePath(`/learn/${c.slug}/`, locale)}
              >
                <span class="reading caption dim-label">{t("learn.readingTime", { minutes: readingMinutes(c.body, locale) })}</span>
              </ActionRow>
            ))}
          </BoxedList>
        ) : null;
      })
    }
  </div>
</Base>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-4) var(--space-6);
    max-inline-size: calc(var(--text-width) + 2 * var(--gutter));
  }

  .page-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
  }

  /* One line of description per row (the chapter page and its meta
     description carry the full text). BoxedList does not take this page's
     scope, hence the page-unique global class. */
  :global(.learn-chapters .adw-row-subtitle) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reading {
    white-space: nowrap;
  }
</style>
