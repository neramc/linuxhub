---
/**
 * The Linuxhub mark: a rounded "window" tile in the Adwaita accent blue with a
 * stylised terminal prompt — drawn for this project (no third-party artwork).
 */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  class="brand-mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <rect x="1" y="1" width="30" height="30" rx="8" fill="#1c71d8"></rect>
  <rect x="1" y="1" width="30" height="9" rx="8" fill="#3584e4"></rect>
  <rect x="1" y="6" width="30" height="4" fill="#3584e4"></rect>
  <path
    d="M8 15.5l5 3.5-5 3.5"
    fill="none"
    stroke="#fff"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path d="M16 23h8" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path>
</svg>
