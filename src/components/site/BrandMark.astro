---
/**
 * The Linuxhub mark: Tux, the Linux mascot by Larry Ewing (drawn with The
 * GIMP), unmodified — credits in src/assets/brand/README.md and on /about/.
 * Rendered as a cached <img> rather than inline SVG, so its ~12 KB (gzip)
 * are downloaded once instead of with every page.
 */
import tux from "~/assets/brand/tux.svg?url";

interface Props {
  /** Rendered height in px; Tux is 216 × 256. */
  size?: number;
}
const { size = 32 } = Astro.props;
---

<img
  class="brand-mark"
  src={tux}
  width={Math.round((size * 216) / 256)}
  height={size}
  alt=""
  decoding="async"
/>
