---
/**
 * Minimal footer (ADR-0014, SPEC §10): the Tux brand, one row of links (About,
 * Releases, Compare, RSS, source code) and one legal line (trademark notice +
 * license). The header and main menu carry the rest of the navigation.
 */
import { type Locale, localizePath, useTranslations } from "~/i18n";
import BrandMark from "./BrandMark.astro";
import { navItem } from "./nav";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const links = [
  navItem("about", locale, path),
  navItem("releases", locale, path),
  navItem("compare", locale, path),
  { href: localizePath("/rss.xml", locale), label: t("footer.feed") },
  { href: "https://github.com/neramc/linuxhub", label: t("footer.source") },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <BrandMark size={28} />
      <span class="heading">{t("site.name")}</span>
    </div>
    <nav class="footer-nav" aria-label={t("footer.label")}>
      <ul class="footer-links" role="list">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <p class="footer-legal caption dim-label">
      {/* No-break spaces keep "© year Linuxhub" on one line (no lone "©"). */}
      {`${t("footer.trademarks")} ${t("footer.license")} ©\u00a0${year}\u00a0Linuxhub`}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    padding-block: var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom));
  }

  .footer-inner {
    display: grid;
    gap: var(--space-2);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--control-height); /* 36px; 44px on touch screens */
    color: inherit;
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  /* 44px wide targets for short labels (RSS) on touch screens, without
     moving the text: the padding is taken back by the margin. */
  @media (pointer: coarse) {
    .footer-links a {
      padding-inline: var(--space-1);
      margin-inline: calc(-1 * var(--space-1));
    }
  }

  @media (width >= 1000px) {
    .footer-inner {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: var(--space-5);
    }

    .footer-nav {
      justify-self: end;
    }

    .footer-legal {
      grid-column: 1 / -1;
    }
  }
</style>
