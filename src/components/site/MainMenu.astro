---
/**
 * GNOME-style primary menu (the "hamburger" popover in a header bar), without
 * leading icons (SPEC §10): below 768px the four primary destinations first,
 * then Releases, Family and About, then the style switcher and one row that
 * switches to the other language. Built on the HTML Popover API, so opening,
 * closing on Esc (focus returns to the button) and light dismiss need no JS.
 * theme.ts wires the style switcher (hidden without JS), closes the menu when
 * focus leaves it, and keeps the query and hash on the language row.
 */
import {
  LOCALE_META,
  LOCALES,
  type Locale,
  localizePath,
  stripLocale,
  useTranslations,
} from "~/i18n";
import Button from "../adw/Button.astro";
import Icon from "../adw/Icon.astro";
import { primaryNav, secondaryNav } from "./nav";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const basePath = stripLocale(Astro.url.pathname);
const primary = primaryNav(locale, Astro.url.pathname);
const secondary = secondaryNav(locale, Astro.url.pathname);
const other = LOCALES.find((l) => l !== locale) ?? locale;
const themes = [
  { value: "system", label: t("theme.system") },
  { value: "light", label: t("theme.light") },
  { value: "dark", label: t("theme.dark") },
] as const;
---

<Button
  variant="flat"
  icon="menu"
  label={t("nav.mainMenu")}
  class="main-menu-button"
  popovertarget="main-menu"
/>

<div id="main-menu" class="main-menu" popover>
  <div class="menu-section menu-primary">
    {
      primary.map((item) => (
        <a class="adw-nav-row" href={item.href} aria-current={item.current ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
  </div>

  <div class="menu-section">
    {
      secondary.map((item) => (
        <a class="adw-nav-row" href={item.href} aria-current={item.current ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
  </div>

  <fieldset class="menu-section style-switcher" data-js-only>
    <legend class="visually-hidden">{t("theme.label")}</legend>
    {
      themes.map((theme) => (
        <label class:list={["style-option", theme.value]} title={theme.label}>
          <input type="radio" name="lh-theme" value={theme.value} />
          <span class="visually-hidden">{theme.label}</span>
          <Icon name="check" class="style-check" />
        </label>
      ))
    }
  </fieldset>

  <div class="menu-section">
    <a
      class="adw-nav-row"
      href={localizePath(basePath, other)}
      hreflang={LOCALE_META[other].htmlLang}
      lang={LOCALE_META[other].htmlLang}
      data-lang-switch
    >
      {LOCALE_META[other].label}
    </a>
  </div>
</div>

<script>
  import "~/scripts/theme";
</script>

<style>
  /* Header icon buttons are 44 × 44 at every width (SPEC §7). */
  .main-menu-button {
    --control-height: 44px;
  }

  .main-menu {
    position: fixed;
    inset: auto;
    inset-block-start: calc(var(--headerbar-height) + 4px);
    inset-inline-end: max(var(--gutter), calc((100vw - var(--content-width)) / 2));
    margin: 0;
    inline-size: max-content;
    min-inline-size: 240px;
    max-inline-size: calc(100vw - 2 * var(--gutter));
    max-block-size: calc(100dvh - var(--headerbar-height) - var(--space-2));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px;
    border: 0;
    border-radius: var(--radius-popover);
    background-color: var(--popover-bg-color);
    color: var(--popover-fg-color);
    box-shadow: var(--shadow-popover);
  }

  .main-menu:popover-open {
    display: grid;
  }

  .menu-section {
    display: grid;
  }

  /* GtkPopoverMenu separators between sections. */
  .menu-section + .menu-section {
    margin-block-start: 6px;
    padding-block-start: 6px;
    border-block-start: 1px solid var(--border-color);
  }

  .style-switcher {
    display: flex;
    justify-content: center;
    gap: 18px;
    min-inline-size: 0;
    margin-inline: 0;
    padding-inline: 6px;
    padding-block-end: 8px;
    border-inline: 0;
    border-block-end: 0;
  }

  .menu-section.style-switcher {
    padding-block-start: 12px;
  }

  .style-option {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--border-color);
  }

  /* The switcher previews each style's window background (#ffffff / #222226). */
  .style-option.system {
    background: linear-gradient(-45deg, #222226 49.99%, #ffffff 50.01%);
  }

  .style-option.light {
    background: #ffffff;
  }

  .style-option.dark {
    background: #222226;
  }

  .style-option input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .style-option:has(input:checked) {
    box-shadow: 0 0 0 2px var(--accent-bg-color);
  }

  .style-option:has(input:focus-visible) {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 3px;
  }

  /* Icon renders raw SVG, which carries no scoped-style attribute. */
  .style-option :global(.style-check) {
    opacity: 0;
    padding: 2px;
    border-radius: 50%;
    background: var(--accent-bg-color);
    color: var(--accent-fg-color);
    position: absolute;
    inset-block-end: -2px;
    inset-inline-end: -2px;
    inline-size: 18px;
    block-size: 18px;
  }

  .style-option:has(input:checked) :global(.style-check) {
    opacity: 1;
  }

  /* Forced colors drop the popover shadow: a transparent border gives it an
     edge (SPEC §4). The swatches preview real colors: keep them, or they
     would be blank circles, and edge them in the system text color (the dark
     swatch on a black canvas). */
  @media (forced-colors: active) {
    .main-menu {
      border: 1px solid transparent;
    }

    .style-option {
      forced-color-adjust: none;
      border: 1px solid CanvasText;
    }

    .style-option:has(input:focus-visible) {
      outline-color: Highlight;
    }

    .style-option:has(input:checked) {
      box-shadow: 0 0 0 2px Highlight;
    }
  }

  /* From 768px the header shows the primary destinations (the same query as
     HeaderBar.astro: em follows the browser's font-size setting). */
  @media (width >= 768px) and (width >= 48em) {
    .menu-primary {
      display: none;
    }

    .menu-primary + .menu-section {
      margin-block-start: 0;
      padding-block-start: 0;
      border-block-start: 0;
    }
  }
</style>
