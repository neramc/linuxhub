---
/**
 * A distro's desktop screenshot (ADR-0018) at the end of its overview: what it
 * shows, then the credit the license asks for (author, license, the file's
 * description page).
 */
import Screenshot from "~/components/adw/Screenshot.astro";
import ScreenshotCredit from "~/components/ScreenshotCredit.astro";
import type { Locale } from "~/i18n";
import type { DistroData } from "~/lib/schemas";
import { screenshotImage } from "~/lib/screenshots";

interface Props {
  shot: NonNullable<DistroData["screenshot"]>;
  locale: Locale;
}

const { shot, locale } = Astro.props;
---

<Screenshot src={screenshotImage(shot.file)} alt={shot.alt[locale]}>
  <span>{shot.caption[locale]}</span>
  <ScreenshotCredit shot={shot} locale={locale} />
</Screenshot>
