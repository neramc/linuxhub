---
/**
 * "On this page" navigation from MDX headings: one flat navigation row
 * (`.adw-nav-row`) per h2, h3 rows indented under their h2.
 */
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  title: string;
  /** Omit the visible title when a surrounding disclosure already shows it. */
  hideTitle?: boolean | undefined;
}

const { headings, title, hideTitle = false } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label={title}>
      {!hideTitle && <p class="toc-title caption-heading dim-label">{title}</p>}
      <ul role="list">
        {items.map((h) => (
          <li>
            <a class:list={["adw-nav-row", { sub: h.depth === 3 }]} href={`#${h.slug}`}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    display: grid;
    gap: var(--space-1);
  }

  /* In line with the rows' text. */
  .toc-title {
    padding-inline: 12px;
  }

  .sub {
    padding-inline-start: var(--space-4);
  }
</style>
