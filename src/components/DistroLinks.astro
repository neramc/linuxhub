---
/**
 * Official links of a distro. A row shows its host name only when the link
 * leaves the project's own domain (e.g. GitHub, SourceForge), so readers can
 * still tell where an outside link goes without seven repeated host names.
 */
import { type Locale, useTranslations } from "~/i18n";
import type { Distro } from "~/lib/catalog";
import ActionRow from "./adw/ActionRow.astro";
import BoxedList from "./adw/BoxedList.astro";

interface Props {
  distro: Distro;
  locale: Locale;
}

const { distro, locale } = Astro.props;
const t = useTranslations(locale);
const l = distro.data.links;
const rows = [
  { key: "home", url: l.home, icon: "website" },
  { key: "download", url: l.download, icon: "download" },
  { key: "docs", url: l.docs, icon: "docs" },
  { key: "installGuide", url: l.installGuide, icon: "contents" },
  { key: "releaseNotes", url: l.releaseNotes, icon: "document" },
  { key: "forum", url: l.forum, icon: "community" },
  { key: "source", url: l.source, icon: "engineering" },
] as const;

/** Second-level public suffixes, so "example.co.uk" is not read as "co.uk". */
const MULTI_LABEL_SUFFIXES = new Set([
  "co.uk",
  "org.uk",
  "com.au",
  "co.jp",
  "com.cn",
  "com.br",
  "co.kr",
  "or.kr",
]);

/** The registrable domain of a URL's host ("docs.fedoraproject.org" → "fedoraproject.org"). */
function site(url: string): string {
  const labels = new URL(url).hostname.split(".");
  const two = labels.slice(-2).join(".");
  return MULTI_LABEL_SUFFIXES.has(two) ? labels.slice(-3).join(".") : two;
}

const home = site(l.home);
const hostLabel = (url: string) => {
  const host = new URL(url).hostname;
  return site(url) === home ? undefined : host.replace(/^www\./, "");
};
---

<BoxedList title={t("distro.links")} level={2}>
  {
    rows
      .filter((r) => r.url)
      .map((r) => (
        <ActionRow title={t(`links.${r.key}`)} subtitle={hostLabel(r.url as string)} icon={r.icon} href={r.url} external />
      ))
  }
</BoxedList>
