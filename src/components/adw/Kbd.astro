---
/** Keyboard key cap, as in libadwaita's shortcut labels. */
---

<kbd class="adw-kbd"><slot /></kbd>

<style is:global>
  .adw-kbd {
    display: inline-block;
    min-inline-size: 1.6em;
    padding: 1px 6px;
    border-radius: 6px;
    background-color: var(--button-color);
    box-shadow: inset 0 -1px var(--border-color);
    font-family: var(--font-sans);
    font-size: 0.8125em;
    font-weight: 700;
    text-align: center;
    line-height: 1.6;
  }
</style>
