---
/**
 * Small pill label for facets (family, release model, desktop…). Neutral by
 * default; `accent`/`success`/`warning`/`error` use libadwaita semantic colors.
 * With `href` it becomes a link (e.g. to a filtered catalog).
 */
interface Props {
  tone?: "neutral" | "accent" | "success" | "warning" | "error";
  href?: string;
  class?: string;
}

const { tone = "neutral", href, class: className } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class:list={["adw-badge", tone, className]} {...(href ? { href } : {})}><slot /></Tag>

<style is:global>
  .adw-badge {
    --badge-color: currentColor;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-block-size: 24px;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--badge-color) 10%, transparent);
    color: inherit;
    font-size: var(--text-caption);
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
  }

  a.adw-badge:hover {
    background-color: color-mix(in srgb, var(--badge-color) 16%, transparent);
    text-decoration: none;
  }

  .adw-badge.accent {
    --badge-color: var(--accent-color);
    color: var(--accent-color);
  }

  .adw-badge.success {
    --badge-color: var(--success-color);
    color: var(--success-color);
  }

  .adw-badge.warning {
    --badge-color: var(--warning-color);
    color: var(--warning-color);
  }

  .adw-badge.error {
    --badge-color: var(--error-color);
    color: var(--error-color);
  }
</style>
