---
/**
 * libadwaita AdwBanner: a full-width strip with an optional action. Neutral
 * gray by default (as in libadwaita); `tone="warning"` tints it with the
 * warning color for a real risk, such as stale release data (SPEC §16).
 */
interface Props {
  title: string;
  tone?: "neutral" | "warning" | undefined;
  class?: string | undefined;
}

const { title, tone = "neutral", class: className } = Astro.props;
---

<div class:list={["adw-banner", { warning: tone === "warning" }, className]} role="status">
  <p class="adw-banner-title">{title}</p>
  <slot />
</div>
