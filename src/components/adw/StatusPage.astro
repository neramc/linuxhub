---
/**
 * libadwaita AdwStatusPage: a dim 64px symbolic icon, the title, one sentence
 * and one action. For the 404 page only (SPEC §15); other empty states are an
 * inline row inside their component.
 */
import Icon from "./Icon.astro";

interface Props {
  icon?: string | undefined;
  title: string;
  description?: string | undefined;
  /** Heading level; 1 for the full-page state (404). 2 is kept until the
      in-page users move to inline empty rows (PLAN C20). */
  level?: 1 | 2 | undefined;
}

const { icon, title, description, level = 1 } = Astro.props;
const Heading = `h${level}` as "h1" | "h2";
---

<div class="adw-status-page">
  {icon && <Icon name={icon} size={64} class="adw-status-icon" />}
  <Heading class="adw-status-title">{title}</Heading>
  {description && <p class="adw-status-description">{description}</p>}
  <div class="adw-status-actions"><slot /></div>
</div>
