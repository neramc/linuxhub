---
/** libadwaita AdwStatusPage: big dimmed icon, title, description, actions. */
import Icon from "./Icon.astro";

interface Props {
  icon?: string;
  title: string;
  description?: string;
  /** Heading level; 1 for full-page states (404), 2 inside a page. */
  level?: 1 | 2;
}

const { icon, title, description, level = 1 } = Astro.props;
const Heading = `h${level}` as "h1" | "h2";
---

<div class="adw-status-page">
  {icon && <Icon name={icon} size={96} class="adw-status-icon" />}
  <Heading class="adw-status-title">{title}</Heading>
  {description && <p class="adw-status-description">{description}</p>}
  <div class="adw-status-actions"><slot /></div>
</div>

<style is:global>
  .adw-status-page {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-2);
    text-align: center;
  }

  .adw-status-icon {
    opacity: var(--dim-opacity);
    margin-block-end: var(--space-3);
  }

  .adw-status-title {
    font-size: var(--text-title-1);
    font-weight: 800;
  }

  .adw-status-description {
    max-inline-size: 36rem;
    text-wrap: balance;
  }

  .adw-status-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-block-start: var(--space-3);
  }

  .adw-status-actions:empty {
    display: none;
  }
</style>
