---
/**
 * libadwaita AdwStatusPage: a dim 64px symbolic icon, the page's h1, one
 * sentence and one action. For the 404 page only (SPEC §15); other empty
 * states are an inline row inside their component.
 */
import Icon from "./Icon.astro";

interface Props {
  icon?: string | undefined;
  title: string;
  description?: string | undefined;
}

const { icon, title, description } = Astro.props;
---

<div class="adw-status-page">
  {icon && <Icon name={icon} size={64} class="adw-status-icon" />}
  <h1>{title}</h1>
  {description && <p class="adw-status-description">{description}</p>}
  <div class="adw-status-actions"><slot /></div>
</div>
