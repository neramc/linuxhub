---
/**
 * libadwaita `.card` (widgets/_misc.scss). With `href` it becomes an
 * activatable card: the whole surface is one link, with the 3%/8% hover/active
 * tint libadwaita uses.
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  href?: string | undefined;
  as?: "div" | "article" | "section" | "li" | undefined;
  padded?: boolean | undefined;
};

const { href, as = "div", padded = true, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : as;
---

<Tag
  class:list={["adw-card", { activatable: href, padded }, className]}
  {...(href ? { href } : {})}
  {...rest}
>
  <slot />
</Tag>
