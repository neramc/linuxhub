---
/**
 * libadwaita AdwViewSwitcher as navigation links, drawn as a toggle group
 * (.adw-toggle-group): the current item is the raised white toggle on the
 * trough and carries aria-current="page". Use for tabs between pages or views
 * (e.g. the header's primary navigation).
 */
import Icon from "./Icon.astro";

interface Item {
  href: string;
  label: string;
  icon?: string;
  current?: boolean;
}

interface Props {
  [key: `data-${string}`]: unknown;
  items: Item[];
  label: string;
  class?: string | undefined;
}

const { items, label, class: className, ...rest } = Astro.props;
---

<nav class:list={["adw-toggle-group", className]} aria-label={label} {...rest}>
  {
    items.map((item) => (
      <a href={item.href} class="adw-toggle" aria-current={item.current ? "page" : undefined}>
        {item.icon && <Icon name={item.icon} />}
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>
