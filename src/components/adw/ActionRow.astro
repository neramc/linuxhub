---
/**
 * libadwaita AdwActionRow inside a boxed list: a prefix (a 16px `icon`, or
 * any `prefix` slot content such as an app tile), the title (`title`, or a
 * rich `title` slot), an optional subtitle (`subtitle`, or a `subtitle` slot,
 * e.g. with a <time>), and a suffix (default slot). With `href` the whole row
 * is a link (activatable) and ends with a chevron or the external-link icon;
 * a `rel="prev"` row points back instead: go-previous at its start, no
 * chevron (a pager's previous row).
 *
 *   <ActionRow href={url} title={name}>
 *     <DistroLogo slot="prefix" file={file} name={name} size={36} />
 *   </ActionRow>
 *
 * `property` rows show a fact: the subtitle is the dim label, the title its
 * value; stacked in narrow lists, label | value from a 480px-wide list.
 *
 * `tone="error"` is a failure inside a component (SPEC §16: icon + color +
 * text): the `warning` icon in the error color, the sentence as the title
 * and the way out (e.g. [Try again]) as the suffix. `hidden` and data-*
 * attributes go on the row (<li>), which an island shows or hides.
 */
import Icon from "./Icon.astro";

interface Props {
  [key: `data-${string}`]: unknown;
  title?: string | undefined;
  subtitle?: string | undefined;
  icon?: string | undefined;
  href?: string | undefined;
  external?: boolean | undefined;
  /** Link types of an `href` row, e.g. "prev" / "next" in a pager. */
  rel?: string | undefined;
  /** A fact row: dim subtitle label, title value (AdwActionRow `.property`). */
  property?: boolean | undefined;
  tone?: "error" | undefined;
  hidden?: boolean | undefined;
}

const {
  title,
  subtitle,
  icon,
  href,
  external = false,
  rel,
  property = false,
  tone,
  ...rest
} = Astro.props;
const Tag = href ? "a" : "div";
const linkRel = [rel, external && "noopener external"].filter(Boolean).join(" ") || undefined;
const back = Boolean(href) && rel?.split(" ").includes("prev");
const prefixIcon = icon ?? (back ? "go-previous" : undefined);
const hasSubtitleSlot = Astro.slots.has("subtitle");
---

<li class="adw-row-item" {...rest}>
  <Tag
    class:list={["adw-action-row", { activatable: href, property }, tone]}
    {...(href ? { href, rel: linkRel, ...(external ? { target: "_blank" } : {}) } : {})}
  >
    {prefixIcon && <Icon name={prefixIcon} size={16} class="adw-row-prefix" />}
    <slot name="prefix" />
    <span class="adw-row-text">
      <span class="adw-row-title">{title}<slot name="title" /></span>
      {
        (subtitle || hasSubtitleSlot) && (
          <span class="adw-row-subtitle">
            {subtitle}
            <slot name="subtitle" />
          </span>
        )
      }
    </span>
    <span class="adw-row-suffix">
      <slot />
      {href && !back && <Icon name={external ? "external" : "go-next"} class="adw-row-chevron" />}
    </span>
  </Tag>
</li>
