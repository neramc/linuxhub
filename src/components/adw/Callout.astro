---
/**
 * A note, tip or warning block for documentation. Not a libadwaita widget,
 * but built only from its tokens, in two looks (ADR-0014): a note ("i") and a
 * tip (lightbulb) are a neutral card with an accent icon; a warning is tinted,
 * so color signals real risk only. The icon and the title are the non-color
 * cues (WCAG 1.4.1). It sets no outer margin: .prose spaces it like any block.
 */
import Icon from "./Icon.astro";

type Kind = "note" | "tip" | "warning";

interface Props {
  type?: Kind | undefined;
  title?: string | undefined;
}

const { type = "note", title } = Astro.props;
const icons: Record<Kind, string> = {
  note: "about",
  tip: "lightbulb",
  warning: "warning",
};
---

<aside class:list={["adw-callout", type]}>
  <Icon name={icons[type]} size={18} class="adw-callout-icon" />
  <div class="adw-callout-body">
    {title && <p class="adw-callout-title">{title}</p>}
    <slot />
  </div>
</aside>
