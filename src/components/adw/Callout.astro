---
/**
 * A note/tip/warning block for documentation. Not a libadwaita widget, but
 * built only from its tokens, in two looks (ADR-0014): note, tip, info and
 * success are a neutral card with an accent icon; warning and danger are
 * tinted, so color signals real risk. The icon and the title are the non-color
 * cues (WCAG 1.4.1).
 */
import Icon from "./Icon.astro";

type Kind = "note" | "info" | "tip" | "success" | "warning" | "danger";

interface Props {
  type?: Kind | undefined;
  title?: string | undefined;
}

const { type = "note", title } = Astro.props;
const icons: Record<Kind, string> = {
  note: "info",
  info: "info",
  tip: "check",
  success: "check",
  warning: "warning",
  danger: "important",
};
---

<aside class:list={["adw-callout", type]}>
  <Icon name={icons[type]} size={18} class="adw-callout-icon" />
  <div class="adw-callout-body">
    {title && <p class="adw-callout-title">{title}</p>}
    <slot />
  </div>
</aside>
