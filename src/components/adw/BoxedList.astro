---
/**
 * libadwaita `list.boxed-list` (widgets/_lists.scss): a card containing
 * separated rows. Put ActionRow / ExpanderRow children inside. An optional
 * title renders like an AdwPreferencesGroup heading: `level={2}` is a section
 * h2 (title-2), levels 3 and 4 a 16px group heading. A rich `title` slot
 * (e.g. a <time>) takes the place of the `title` text. The `suffix` slot sits at
 * the end of the heading row (e.g. a flat "All releases" button); the row is
 * the shared `.section-header` (base.css), so a titled list and a titled card
 * grid on one page line up.
 */
interface Props {
  title?: string | undefined;
  /** Heading level for the group title. */
  level?: 2 | 3 | 4 | undefined;
  class?: string | undefined;
  id?: string | undefined;
}

const { title, level = 3, class: className, id } = Astro.props;
const Heading = `h${level}` as "h2" | "h3" | "h4";
const headingId = id ? `${id}-title` : undefined;
const hasTitle = Boolean(title) || Astro.slots.has("title");
---

<section class:list={["adw-group", className]} id={id} aria-labelledby={hasTitle ? headingId : undefined}>
  {
    (hasTitle || Astro.slots.has("suffix")) && (
      <div class="adw-group-header section-header">
        {hasTitle && (
          <Heading class="adw-group-title" id={headingId}>
            {title}
            <slot name="title" />
          </Heading>
        )}
        <slot name="suffix" />
      </div>
    )
  }
  <ul class="adw-boxed-list" role="list">
    <slot />
  </ul>
</section>
