---
/**
 * Numbered procedure: wrap an ordered list (1. … 2. …) to get step badges.
 * The badges are neutral (a number, not an action), like a default button.
 */
---

<div class="steps"><slot /></div>

<style>
  /* minmax(0, 1fr): wide code blocks inside a step scroll in place instead of
     widening the article. */
  .steps :global(> ol) {
    list-style: none;
    padding-inline-start: 0;
    counter-reset: step;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }

  .steps :global(> ol > li) {
    position: relative;
    counter-increment: step;
    padding-inline-start: 44px;
  }

  .steps :global(> ol > li)::before {
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    display: grid;
    place-items: center;
    inline-size: 30px;
    block-size: 30px;
    border-radius: 50%;
    background: var(--button-color);
    color: var(--window-fg-color);
    font-size: var(--text-control);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: var(--line-height-control);
  }

  .steps :global(> ol > li + li) {
    margin-block-start: 0;
  }
</style>
