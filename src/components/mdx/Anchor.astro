---
/**
 * Fixed link target for cross-page anchors (MDX has no `{#id}` heading syntax).
 * Standard targets in install guides: verify, usb, boot, install, after-install.
 * The header offset comes from the root scroll-padding (base.css).
 */
interface Props {
  id: string;
}
---

<span id={Astro.props.id} class="anchor-target"></span>

<style>
  .anchor-target {
    display: block;
    block-size: 0;
  }
</style>
