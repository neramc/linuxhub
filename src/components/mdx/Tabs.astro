---
/**
 * OS-specific instructions (Windows / macOS / Linux …) without JS: one boxed
 * list whose rows are collapsible <Tab label="…"> expander rows. A long
 * command scrolls inside its row instead of widening the article: the boxed
 * list is an inline-size container, so its content never sets its width.
 */
import BoxedList from "../adw/BoxedList.astro";
---

<BoxedList class="os-tabs"><slot /></BoxedList>
