---
/** The official checksum of the default image: <Checksum slug="fedora" />. Styled by the shared .checksum rule (adwaita.css). */
import { lookup } from "./data";

interface Props {
  slug: string;
}
const { artifact } = await lookup(Astro.props.slug);
---

{artifact?.checksum ? <code class="checksum">{artifact.checksum.value}</code> : <span>—</span>}
