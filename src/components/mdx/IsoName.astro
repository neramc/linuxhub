---
/**
 * The default image file name from the synced data: <IsoName slug="fedora" />.
 * Long names wrap anywhere through the prose inline-code rule (prose.css).
 */
import { lookup } from "./data";

interface Props {
  slug: string;
}
const { artifact } = await lookup(Astro.props.slug);
---

<code>{artifact?.file ?? "*.iso"}</code>
