---
import { type Locale, localizePath, useTranslations } from "~/i18n";
import { type Chapter, GROUPS } from "~/lib/learn";

interface Props {
  chapters: (Chapter & { slug: string })[];
  current: string;
  locale: Locale;
}

const { chapters, current, locale } = Astro.props;
const t = useTranslations(locale);
---

<nav class="chapter-nav">
  {
    GROUPS.map((group) => {
      const items = chapters.filter((c) => c.data.group === group);
      return items.length ? (
        <div class="chapter-nav-group">
          <p class="caption-heading dim-label">{t(`learn.groups.${group}`)}</p>
          <ul role="list">
            {items.map((c) => (
              <li>
                <a href={localizePath(`/learn/${c.slug}/`, locale)} aria-current={c.slug === current ? "page" : undefined}>
                  {c.data.navTitle}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ) : null;
    })
  }
</nav>

<style>
  .chapter-nav {
    display: grid;
    gap: var(--space-2);
  }

  .chapter-nav-group {
    display: grid;
    gap: 2px;
  }

  .chapter-nav-group p {
    padding-inline: 10px;
    margin-block-end: 2px;
  }

  .chapter-nav-group a {
    display: block;
    padding: 6px 10px;
    border-radius: var(--radius-menu);
    color: inherit;
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .chapter-nav-group a:hover {
    background: var(--hover-color);
  }

  .chapter-nav-group a[aria-current="page"] {
    background: var(--selected-color);
    font-weight: 700;
  }
</style>
