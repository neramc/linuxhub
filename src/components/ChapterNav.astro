---
/**
 * Linux guide sidebar (navigation-sidebar style): chapters by group, with the
 * current chapter's h2 sections nested under it (this replaces a separate
 * "On this page" column). Used in the wide sidebar and in the narrow-screen
 * chapters disclosure.
 */
import type { MarkdownHeading } from "astro";
import { type Locale, localizePath, useTranslations } from "~/i18n";
import { type Chapter, GROUPS } from "~/lib/learn";

interface Props {
  chapters: (Chapter & { slug: string })[];
  current: string;
  locale: Locale;
  /** Headings of the current chapter; its h2 sections are listed under it. */
  headings?: MarkdownHeading[] | undefined;
  /** Accessible name of the <nav>. */
  label: string;
}

const { chapters, current, locale, headings = [], label } = Astro.props;
const t = useTranslations(locale);
const sections = headings.filter((h) => h.depth === 2);
---

<nav class="chapter-nav" aria-label={label}>
  {
    GROUPS.map((group) => {
      const items = chapters.filter((c) => c.data.group === group);
      return items.length ? (
        <div class="chapter-nav-group">
          <p class="caption-heading dim-label">{t(`learn.groups.${group}`)}</p>
          <ul role="list">
            {items.map((c) => (
              <li>
                <a
                  class="chapter-link"
                  href={localizePath(`/learn/${c.slug}/`, locale)}
                  aria-current={c.slug === current ? "page" : undefined}
                >
                  {c.data.navTitle}
                </a>
                {c.slug === current && sections.length > 0 && (
                  <ul class="sections" role="list">
                    {sections.map((h) => (
                      <li>
                        <a href={`#${h.slug}`}>{h.text}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      ) : null;
    })
  }
</nav>

<style>
  .chapter-nav {
    display: grid;
    gap: var(--space-3);
  }

  .chapter-nav-group {
    display: grid;
    gap: 2px;
  }

  .chapter-nav-group > p {
    padding-inline: 12px;
    margin-block-end: 2px;
  }

  ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 7px 12px;
    border-radius: var(--radius-menu);
    color: inherit;
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.4;
    transition: background-color var(--duration) var(--ease-out-quad);
  }

  a:hover {
    background-color: var(--hover-color);
  }

  a:active {
    background-color: var(--active-color);
  }

  a:focus-visible {
    outline-offset: -2px;
    border-radius: var(--radius-menu);
  }

  .chapter-link[aria-current="page"] {
    background-color: var(--selected-color);
    font-weight: 700;
  }

  /* Sections of the current chapter: indented, smaller, dim until hovered. */
  .sections {
    margin-block: 2px 4px;
    margin-inline-start: 12px;
    padding-inline-start: 2px;
    border-inline-start: 1px solid var(--border-color);
  }

  .sections a {
    padding-block: 5px;
    font-size: 0.875rem;
    opacity: var(--dim-opacity);
  }

  .sections a:hover {
    opacity: 1;
  }
</style>
