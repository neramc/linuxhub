---
/**
 * Linux guide local navigation (AdwNavigationSidebar look): the chapters by
 * group as navigation rows (`.adw-nav-row`), the current chapter's h2
 * sections nested under it by `Toc` as a named list inside this one
 * landmark (this replaces a separate "On this page" column). Used in the wide
 * sidebar and in the narrow-screen chapters disclosure.
 */
import type { MarkdownHeading } from "astro";
import { type Locale, localizePath, useTranslations } from "~/i18n";
import { type Chapter, GROUPS } from "~/lib/learn";
import Toc from "./Toc.astro";

interface Props {
  chapters: (Chapter & { slug: string })[];
  current: string;
  locale: Locale;
  /** Headings of the current chapter; its h2 sections are listed under it. */
  headings?: MarkdownHeading[] | undefined;
  /** Accessible name of the <nav>. */
  label: string;
}

const { chapters, current, locale, headings = [], label } = Astro.props;
const t = useTranslations(locale);
const sections = headings.filter((h) => h.depth === 2);
---

<nav class="chapter-nav" aria-label={label}>
  {
    GROUPS.map((group) => {
      const items = chapters.filter((c) => c.data.group === group);
      return items.length ? (
        <div class="chapter-nav-group">
          <p class="caption-heading dim-label">{t(`learn.groups.${group}`)}</p>
          <ul role="list">
            {items.map((c) => (
              <li>
                <a
                  class="adw-nav-row"
                  href={localizePath(`/learn/${c.slug}/`, locale)}
                  aria-current={c.slug === current ? "page" : undefined}
                >
                  {c.data.navTitle}
                </a>
                {c.slug === current && sections.length > 0 && (
                  <div class="sections">
                    <Toc headings={sections} title={t("learn.sections")} nested />
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      ) : null;
    })
  }
</nav>

<style>
  .chapter-nav {
    display: grid;
    gap: var(--space-3);
  }

  .chapter-nav-group {
    display: grid;
    gap: var(--space-1);
  }

  /* In line with the rows' text, as the Toc title. */
  .chapter-nav-group > p {
    padding-inline: 12px;
  }

  /* The current chapter's sections, one step in (their text lines up with
     the Toc's h3 rows on the install guides). */
  .sections {
    padding-inline-start: var(--space-2);
  }
</style>
