---
/**
 * Desktop screenshots of a few distros on the home page (ADR-0020), a weekly
 * rotation through every distro that has one (ADR-0018). Each tile is the
 * screenshot, the distro's name (the link; the image is a pointer shortcut to
 * it) with what the screenshot shows, and the credit its license asks for.
 * Three columns from 1000px, two from 600px; on phones one row that scrolls
 * sideways and bleeds into the gutter (like the use-case chips), so the page
 * never scrolls sideways and a cut-off tile shows there is more.
 */
import Screenshot from "~/components/adw/Screenshot.astro";
import ScreenshotCredit from "~/components/ScreenshotCredit.astro";
import { type Locale, localizePath } from "~/i18n";
import type { Distro } from "~/lib/catalog";
import { screenshotImage } from "~/lib/screenshots";

interface Props {
  /** Distros with a screenshot. */
  distros: readonly Distro[];
  locale: Locale;
}

const { distros, locale } = Astro.props;
const tiles = distros.flatMap((d) =>
  d.data.screenshot ? [{ distro: d, shot: d.data.screenshot }] : [],
);
---

<ul class="desktop-gallery" role="list">
  {
    tiles.map(({ distro, shot }) => {
      const href = localizePath(`/distros/${distro.id}/`, locale);
      return (
        <li>
          <Screenshot
            src={screenshotImage(shot.file)}
            alt={shot.alt[locale]}
            href={href}
            widths={[480, 800]}
            sizes="(width >= 1000px) 400px, (width >= 600px) 50vw, 80vw"
            class="desktop-tile"
          >
            <h3 class="desktop-tile-name">
              <a href={href}>{distro.data.name}</a>
            </h3>
            <span>{shot.caption[locale]}</span>
            <ScreenshotCredit shot={shot} locale={locale} />
          </Screenshot>
        </li>
      );
    })
  }
</ul>

<style>
  .desktop-gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80vw, 400px);
    gap: var(--space-grid);
    margin: -4px calc(-1 * var(--gutter)) calc(-1 * var(--space-2));
    padding: 4px var(--gutter) var(--space-2);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
  }

  .desktop-gallery > li {
    scroll-snap-align: start;
    min-inline-size: 0;
  }

  .desktop-gallery :global(.desktop-tile) {
    max-inline-size: none;
  }

  /* One 16:9 frame (the shape of most screenshots) for every tile, so the
     names line up: a screenshot of another shape is letterboxed on the card
     background, never cropped (ADR-0018). */
  .desktop-gallery :global(.adw-screenshot-image) {
    aspect-ratio: 16 / 9;
    object-fit: contain;
  }

  .desktop-tile-name {
    font-size: var(--text-heading);
    font-weight: 700;
    line-height: var(--line-height-heading);
  }

  .desktop-tile-name > a {
    color: inherit;
    text-decoration: none;
  }

  .desktop-tile-name > a:hover {
    text-decoration: underline;
  }

  @media (width >= 600px) {
    .desktop-gallery {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }

  @media (width >= 1000px) {
    .desktop-gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (pointer: coarse) {
    .desktop-gallery {
      scrollbar-width: none;
    }

    .desktop-gallery::-webkit-scrollbar {
      display: none;
    }
  }
</style>
