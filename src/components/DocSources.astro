---
/**
 * Citation footer for a document (CLAUDE.md rule 7): the official sources and
 * the last review date as a one-row boxed list with a closed expander row
 * ("Official sources (N)" · "Last reviewed …"). Everything stays in the HTML;
 * only the list is folded. Used at the end of install guides and Linux guide
 * chapters (inside .prose).
 */
import { type Locale, useTranslations } from "~/i18n";
import { formatDate } from "~/lib/catalog";
import BoxedList from "./adw/BoxedList.astro";
import ExpanderRow from "./adw/ExpanderRow.astro";

interface Props {
  sources: string[];
  lastReviewed: string;
  locale: Locale;
}

const { sources, lastReviewed, locale } = Astro.props;
const t = useTranslations(locale);
const [before, after] = t("sources.reviewed", { date: "\u0000" }).split("\u0000");
---

<BoxedList class="doc-sources-group">
  <ExpanderRow class="doc-sources" title={t("sources.title", { count: sources.length })} data-pagefind-ignore="">
    <Fragment slot="subtitle">{before}<time datetime={lastReviewed}>{formatDate(lastReviewed, locale)}</time>{after}</Fragment>
    <div class="doc-sources-body">
      <p class="dim-label">{t("sources.note")}</p>
      <ul>
        {sources.map((url) => <li><a href={url} rel="noopener external">{url.replace(/^https:\/\//, "")}</a></li>)}
      </ul>
    </div>
  </ExpanderRow>
</BoxedList>

<style>
  /* The citation footer ends the article: section spacing above it. */
  :global(.prose > .doc-sources-group) {
    margin-block-start: var(--space-5);
  }

  .doc-sources-body {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-caption);
    line-height: var(--line-height-caption);
  }

  /* Discs, not the nested-list circles (the list sits inside the boxed list). */
  .doc-sources-body ul {
    list-style-type: disc;
  }

  /* Long URLs wrap anywhere instead of setting the list's min-content width
     (the reset gives li `break-word`, which let them clip at 320/390px). */
  .doc-sources-body li,
  .doc-sources-body a {
    overflow-wrap: anywhere;
  }
</style>
