---
/**
 * Flathub-style app tile for a distribution: the logo on a 64px app tile, the
 * name and a two-line tagline (ADR-0014: no badges). The whole card is one
 * link. Facets for filtering live as data-* attributes on the list item that
 * wraps the card, not on the card. Extra attributes are passed to the card.
 */
import type { CollectionEntry } from "astro:content";
import { type Locale, localizePath } from "~/i18n";
import Card from "./adw/Card.astro";
import DistroLogo from "./DistroLogo.astro";

interface Props {
  [key: `data-${string}`]: unknown;
  distro: CollectionEntry<"distros">;
  locale: Locale;
  eager?: boolean | undefined;
  headingLevel?: 2 | 3 | undefined;
  class?: string | undefined;
}

const { distro, locale, eager = false, headingLevel = 3, class: className, ...rest } = Astro.props;
const d = distro.data;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<Card
  href={localizePath(`/distros/${distro.id}/`, locale)}
  class={className ? `distro-card ${className}` : "distro-card"}
  padded={false}
  {...rest}
>
  <DistroLogo file={d.logo.file} name={d.name} size={64} eager={eager} />
  <div class="distro-card-text">
    <Heading class="distro-card-name">{d.name}</Heading>
    <p class="distro-card-tagline">{d.tagline[locale]}</p>
  </div>
</Card>

<style>
  :global(.adw-card.distro-card) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    block-size: 100%;
  }

  .distro-card-text {
    display: grid;
    gap: 2px;
    min-inline-size: 0;
  }

  .distro-card-name {
    font-size: var(--text-title-4);
    font-weight: 700;
    line-height: 1.3;
  }

  .distro-card-tagline {
    opacity: var(--dim-opacity);
    font-size: 0.9375rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
