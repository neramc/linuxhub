# Web environment — apps/web (SvelteKit on Vercel)
#
# Copy to `.env` for local development (gitignored):
#
#   cp apps/web/.env.example apps/web/.env
#
# In production these are Vercel Project → Settings → Environment Variables.
# Full procedure in docs/deployment.md.
#
# ---------------------------------------------------------------------------
# SET THE FIRST TWO BEFORE THE FIRST REAL DEPLOY.
#
# A deploy with them empty still builds and serves — that is deliberate, so a
# frontend deploy is never blocked on a Worker. But it serves the COMMITTED
# SNAPSHOT in apps/web/src/lib/server/data.ts for every route, and the download
# buttons resolve nothing at all, because no snapshot ever carried an artifact
# path or a checksum.
#
# `GET /api/v1/health` reports which mode is live ("worker" or "snapshot"), and
# the mode is logged once per cold start. Check it after deploying.
# ---------------------------------------------------------------------------

# Base URL of the deployed Worker, with no trailing slash. After
# `wrangler deploy` it is printed as the workers.dev URL, e.g.
# https://linuxhub-api.<your-subdomain>.workers.dev
# READ BY THE CODE. Unset = snapshot mode. Server-only — never PUBLIC_.
LINUXHUB_API_URL=

# READ BY THE CODE. Must match the Worker secret of the same name exactly, or
# the Worker answers 404 to everything the BFF asks for — see .ai/api.md for
# why a bad token is a 404 rather than a 403. Server-only — never PUBLIC_, or
# the shared secret ships to the browser.
INTERNAL_API_TOKEN=

# hCaptcha SITE key — the public half, safe in the browser, which is why it
# carries the PUBLIC_ prefix SvelteKit requires for client-exposed values.
# The secret half is a Wrangler secret on the Worker, never here.
# NOT read yet — the write endpoints arrive in task 5.5.
PUBLIC_HCAPTCHA_SITEKEY=
