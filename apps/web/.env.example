# Web environment — apps/web (SvelteKit on Vercel)
#
# Copy to `.env` for local development (gitignored):
#
#   cp apps/web/.env.example apps/web/.env
#
# In production these are Vercel Project → Settings → Environment Variables.
# Full procedure in docs/deployment.md.
#
# ---------------------------------------------------------------------------
# Nothing here is read by the code yet.
#
# The BFF still serves apps/web/src/lib/server/data.ts directly; it starts
# calling the Worker in task 5.4, and the contribute forms start needing
# hCaptcha in 5.5. Setting these now is harmless and means the deploy that
# lands 5.4 needs no dashboard visit — but a deploy today works with all of
# them empty.
# ---------------------------------------------------------------------------

# Base URL of the deployed Worker, with no trailing slash. After
# `wrangler deploy` it is printed as the workers.dev URL, e.g.
# https://linuxhub-api.<your-subdomain>.workers.dev
# Used from task 5.4. Server-only — do NOT prefix with PUBLIC_.
LINUXHUB_API_URL=

# Must match the Worker secret of the same name exactly, or the Worker answers
# 404 to everything the BFF asks for. Server-only — never PUBLIC_, or the
# shared secret ships to the browser.
INTERNAL_API_TOKEN=

# hCaptcha SITE key — the public half, safe in the browser, which is why it
# carries the PUBLIC_ prefix SvelteKit requires for client-exposed values.
# The secret half is a Wrangler secret on the Worker, never here.
# Used from task 5.5.
PUBLIC_HCAPTCHA_SITEKEY=
