{
	"name": "linuxhub",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.11",
	"engines": {
		"bun": ">=1.2.0"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"svelte": "^5.30.0",
			"typescript": "^5.9.0",
			"vitest": "^3.2.0"
		}
	},
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "bun run --filter '*' check",
		"check:boundaries": "bun scripts/check-boundaries.ts",
		"test": "bun run --filter '*' test",
		"build": "bun run --filter '*' build",
		"dev:web": "bun run --filter '@linuxhub/web' dev",
		"dev:api": "bun run --filter '@linuxhub/api' dev"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"typescript": "catalog:"
	}
}
