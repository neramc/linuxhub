{
  "name": "linuxhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fast, bilingual (ko/en) catalog of Linux distributions with official downloads and install guides.",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "bun scripts/serve.ts --port=4321",
    "check": "astro check && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync": "bun scripts/sync/run.ts",
    "sync:validate": "bun scripts/sync/validate.ts",
    "sync:docs": "bun scripts/sync/docs.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@vercel/functions": "^3.9.11",
    "astro": "^7.3.5",
    "astro-pagefind": "^2.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^24",
    "robots-parser": "^3.0.1",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
